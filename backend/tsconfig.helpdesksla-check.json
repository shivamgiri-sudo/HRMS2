  //
  //     npx tsc -p tsconfig.helpdesksla-check.json
  "extends": "./tsconfig.json",
  "include": [
    "src/modules/helpdesk/helpdesk-sla.cron.ts",
    "src/modules/helpdesk/helpdesk-sla.service.ts",
    "src/server.ts",
    "src/workers/all-workers.ts"
  ]
}
