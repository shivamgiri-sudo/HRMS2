LUCKPAY_PROVIDER_ENABLED=false

# ── WhatsApp Notifications (choose ONE provider) ─────────────────────────────
# Option A: Twilio WhatsApp Business
# Set WHATSAPP_PROVIDER=twilio and fill in your Twilio credentials.
# Free sandbox: twilio.com/console/messaging/whatsapp/sandbox
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=+14155238886

# Option B: Meta / Facebook WhatsApp Cloud API
# Set WHATSAPP_PROVIDER=meta and fill in your Meta credentials.
# WHATSAPP_PROVIDER=meta
# META_WHATSAPP_ACCESS_TOKEN=your_meta_access_token
# META_WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Option C: Local WhatsApp API (e.g. whatsapp-web.js self-hosted)
# WHATSAPP_PROVIDER=local
# LOCAL_WHATSAPP_API_URL=http://localhost:3001
# LOCAL_WHATSAPP_API_KEY=your_local_api_key
# LOCAL_WHATSAPP_BUSINESS_NUMBER=+919999999999

# Events that trigger WhatsApp notifications (comma-separated, leave blank to disable)
# Available: leave_submitted,leave_decision,payslip_ready,salary_credited,
#            roster_published,onboarding_welcome,attendance_absent
WHATSAPP_ENABLED_EVENTS=leave_decision,payslip_ready,salary_credited

# ── Cloudinary (optional) — employee profile photo cloud storage ──────────────
# Free tier: 25 GB storage + 25 GB bandwidth/month, no credit card required
# Sign up at https://cloudinary.com/users/register_free
# When these 3 vars are set, photos are stored on Cloudinary instead of local disk.
# Leave blank to use local filesystem (default for local dev).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Report generation worker thresholds ───────────────────────────────────────
# Max rows per XLSX file. Requests exceeding this are failed with ROW_LIMIT_EXCEEDED.
REPORT_MAX_XLSX_ROWS=100000
# Max rows returned by the immediate-export endpoint (GET /api/reports/suite/:code/export).
REPORT_IMMEDIATE_EXPORT_ROWS=500
# Max XLSX attachment size in bytes (20 MB). Files above this trigger a secure download link.
REPORT_ATTACHMENT_MAX_BYTES=20971520
# File size at which a size warning is added to the email body (15 MB).
REPORT_LARGE_FILE_THRESHOLD_BYTES=15728640
# Rows fetched per DB chunk during worker generation (keyset pagination chunk size).
REPORT_WORKER_CHUNK_SIZE=5000
# Retention for restricted/highly_restricted reports (days). Must match privacy policy.
REPORT_RETENTION_RESTRICTED_DAYS=2
# Retention for internal/confidential reports (days).
REPORT_RETENTION_DEFAULT_DAYS=7
# TTL for secure single-use download tokens (hours). Capped at retention days.
REPORT_DOWNLOAD_TOKEN_TTL_HOURS=48

# ─────────────────────────────────────────────────────────────────────────────
# META Campaign Automation (Lead Gen Ads -> screened ATS candidate)
#
# Two data routes, and they behave differently — worth knowing before debugging:
#
#   Flow 1, leads: META PUSHES to us. A form fill hits POST /api/meta/webhooks within seconds.
#     The webhook body carries ONLY form_id + leadgen_id; there is no name, phone or email in it.
#     The backend then fetches the real field values from the Graph API, so
#     META_MARKETING_ACCESS_TOKEN is required even just to read a lead. End-to-end ~3-10s.
#
#   Flow 2, ad metrics: we PULL from META. Nightly cron at META_CAMPAIGN_SYNC_TIME reads
#     /{campaign_id}/insights. META lags ~15-30 min on impressions/reach/clicks and up to 24h on
#     final spend, so running this more often does not make spend more accurate.
#
# Which fields arrive is decided by the Lead Ad FORM, not by us. Name/phone/email are standard;
# age (or DOB), city, education and experience only arrive if marketing added them as custom
# questions. The screener treats a missing field as "not checked", never as a failure — so a form
# without an age question means age is not screened, not that everyone is rejected.
# META never provides: profile photos, Aadhaar/PAN, resumes, or individual ad-viewer data.
#
# One-time Facebook setup:
#   1. Create an app at developers.facebook.com
#   2. Get leads_retrieval (lead field data) + ads_read (insights) approved
#   3. Webhooks -> Object: page, Field: leadgen
#      Callback URL: https://mcnhrms.teammas.in/api/meta/webhooks
#      Verify Token: the META_LEAD_VERIFY_TOKEN value below
#   4. Exchange a short-lived Graph Explorer token for a long-lived (60-day) one:
#      curl "https://graph.facebook.com/oauth/access_token?grant_type=fb_exchange_token\
#        &client_id=APP_ID&client_secret=APP_SECRET&fb_exchange_token=SHORT_LIVED_TOKEN"
#      The token expires in ~60 days. When it does, the nightly sync records the failure on
#      meta_campaign.last_sync_error and the dashboard shows "sync failed" per campaign.
#   5. Per campaign, marketing records the META Campaign ID and Lead Gen Form ID in HRMS:
#      Requisition Detail -> META Campaign Link. Without the FORM ID, leads still arrive and are
#      stored, but cannot be matched to a requisition or screened.

# META_MARKETING_APP_ID=
# META_MARKETING_ACCESS_TOKEN=
# Your own arbitrary secret; must match what you type into the Facebook webhook form.
# Unset = GET /api/meta/webhooks answers 503 and the subscription cannot be verified.
# META_LEAD_VERIFY_TOKEN=
# App Secret, used to verify the X-Hub-Signature-256 HMAC on every incoming webhook.
# Unset = POST /api/meta/webhooks REFUSES every request with 403 rather than trusting it. The
# route is unauthenticated by necessity (META cannot present a session), so this is its only
# real defence — do not run it in production without this set.
# META_APP_SECRET=
# META_GRAPH_API_VERSION=v19.0

# Nightly ad-metrics sync. Off unless exactly "true"; also a no-op without an access token.
# META_CAMPAIGN_SYNC_ENABLED=false
# META_CAMPAIGN_SYNC_TIME=06:00

# Marketing brief recipients are NOT env-configured — they live in
# org_settings.marketing_team_emails (seeded empty by migration 1811, so nothing sends until an
# admin fills it in).

# Outbound voice bot for qualified leads. Unset = the voice channel is skipped, not failed.
# VOICEBOT_TRIGGER_URL=
# VOICEBOT_API_KEY=
# VOICEBOT_CALLBACK_TOKEN=
# Base URL we hand META/the bot for the callback to /api/meta/voice-callback.
# VOICEBOT_CALLBACK_BASE_URL=
# VOICEBOT_DEFAULT_LANGUAGE=hi
# VOICEBOT_SCRIPT_TEMPLATE=recruitment_invite

# WhatsApp outreach for qualified leads goes through the EXISTING local-whatsapp provider
# (the self-hosted /wa bridge), configured by the LOCAL_WHATSAPP_* vars further up this file.
# Set WHATSAPP_PROVIDER=local (or local-whatsapp-tool) to select it.
