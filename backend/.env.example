NODE_ENV=development
PORT=5055
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:5055
# Comma-separated extra CORS origins (e.g. production IP, CDN URL). Never hard-code these in source.
CORS_ALLOWED_ORIGINS=

ACTIVE_DB_PROVIDER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_staging_db
# 25 is the code default (config/env.ts) and the value that resolved the worker circuit-breaker
# resonance: at 10 the workers exhausted the pool, tripped the breaker, retried in lockstep and
# re-exhausted it. This file said 10 long after that fix, so copying it to a new deployment
# reintroduced the incident. Lower it only with a measured reason.
DB_POOL_MAX=25

JWT_SECRET=replace-with-strong-local-jwt-secret-at-least-32-chars
PORTAL_JWT_SECRET=replace-with-strong-local-portal-secret-at-least-32-chars
PAYROLL_BANK_KEY=replace-with-strong-bank-key

# Signs the Asset & Material Exit Pass gate QR token (min 32 chars).
# Optional: when unset it is derived from JWT_SECRET by HKDF-SHA256 under a
# distinct label, so a deployment that has not set it still boots and still
# produces working QRs. Set it to rotate gate QRs independently of session
# signing.
#
# ROTATING THIS INVALIDATES EVERY QR ALREADY PRINTED. The token is derived, not
# stored, so changing the secret changes every pass's token while the stored
# hashes still describe the old ones — those passes fall back to manual
# pass-number entry at the gate (nothing is blocked, but the printed QR is
# dead). Decide it before the first pass is printed, or expect to reprint.
EXIT_PASS_QR_SECRET=replace-with-strong-exit-pass-qr-secret-at-least-32-chars
ENCRYPTION_KEY=replace-with-64-hex-character-key

# Field-level AES-256-GCM encryption for sensitive PII columns
# (employee_bank_detail.account_number_enc, and the Aadhaar/PAN columns).
# Both MUST be exactly 64 hex characters (32 bytes).
#
# These are REQUIRED in production — src/shared/fieldEncryption.ts throws at import
# when NODE_ENV=production and either is unset, so the app will not boot without them.
#
# Outside production they silently fall back to fixed development keys
# (encryption: all zeros). That is fine against a local database, but it means any
# script pointed at a PRODUCTION database from a dev machine will encrypt real rows
# with a key production cannot read — and report success, because the write path
# never attempts a decrypt. Bulk writers must gate on checkKeyParity() first;
# scripts/bank-account-encrypt-backfill.ts does, and refuses to run on a mismatch.
#
# Use the production values when running any backfill against production data.
FIELD_ENCRYPTION_KEY=replace-with-64-hex-character-key
FIELD_BLIND_INDEX_KEY=replace-with-a-different-64-hex-character-key

# AI providers for Mira (all optional; each falls back to the rule-based /
# non-external path when unset). GEMINI_API_KEY and OPENAI_API_KEY are read
# directly from process.env by their respective provider files, matching
# OPENROUTER_API_KEY's existing convention below — not exclusively through
# the encrypted ai_provider_config DB path.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Whisper fallback for voice input on browsers with no Web Speech API (Safari/iOS)
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Presenton sidecar (self-hosted AI presentation generator)
PRESENTON_API_URL=http://localhost:8000
PRESENTON_OLLAMA_MODEL=llama3.2

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=MAS Callnet HRMS

BILL_DB_HOST=127.0.0.1
BILL_DB_PORT=3306
BILL_DB_USER=your_bill_db_user
BILL_DB_PASSWORD=your_bill_db_password
