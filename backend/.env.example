NODE_ENV=development
PORT=5055
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:5055
# Comma-separated extra CORS origins (e.g. production IP, CDN URL). Never hard-code these in source.
CORS_ALLOWED_ORIGINS=

ACTIVE_DB_PROVIDER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_staging_db
# 25 is the code default (config/env.ts) and the value that resolved the worker circuit-breaker
# resonance: at 10 the workers exhausted the pool, tripped the breaker, retried in lockstep and
# re-exhausted it. This file said 10 long after that fix, so copying it to a new deployment
# reintroduced the incident. Lower it only with a measured reason.
DB_POOL_MAX=25

JWT_SECRET=replace-with-strong-local-jwt-secret-at-least-32-chars
PORTAL_JWT_SECRET=replace-with-strong-local-portal-secret-at-least-32-chars
PAYROLL_BANK_KEY=replace-with-strong-bank-key

# Signs the Asset & Material Exit Pass gate QR token (min 32 chars).
# Optional: when unset it is derived from JWT_SECRET by HKDF-SHA256 under a
# distinct label, so a deployment that has not set it still boots and still
# produces working QRs. Set it to rotate gate QRs independently of session
# signing.
#
# ROTATING THIS INVALIDATES EVERY QR ALREADY PRINTED. The token is derived, not
# stored, so changing the secret changes every pass's token while the stored
# hashes still describe the old ones — those passes fall back to manual
# pass-number entry at the gate (nothing is blocked, but the printed QR is
# dead). Decide it before the first pass is printed, or expect to reprint.
EXIT_PASS_QR_SECRET=replace-with-strong-exit-pass-qr-secret-at-least-32-chars
ENCRYPTION_KEY=replace-with-64-hex-character-key

# Field-level AES-256-GCM encryption for sensitive PII columns
# (employee_bank_detail.account_number_enc, and the Aadhaar/PAN columns).
# Both MUST be exactly 64 hex characters (32 bytes).
#
# These are REQUIRED in production — src/shared/fieldEncryption.ts throws at import
# when NODE_ENV=production and either is unset, so the app will not boot without them.
#
# Outside production they silently fall back to fixed development keys
# (encryption: all zeros). That is fine against a local database, but it means any
# script pointed at a PRODUCTION database from a dev machine will encrypt real rows
# with a key production cannot read — and report success, because the write path
# never attempts a decrypt. Bulk writers must gate on checkKeyParity() first;
# scripts/bank-account-encrypt-backfill.ts does, and refuses to run on a mismatch.
#
# Use the production values when running any backfill against production data.
FIELD_ENCRYPTION_KEY=replace-with-64-hex-character-key
FIELD_BLIND_INDEX_KEY=replace-with-a-different-64-hex-character-key

# AI providers for Mira (all optional; each falls back to the rule-based /
# non-external path when unset). GEMINI_API_KEY and OPENAI_API_KEY are read
# directly from process.env by their respective provider files, matching
# OPENROUTER_API_KEY's existing convention below — not exclusively through
# the encrypted ai_provider_config DB path.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Whisper fallback for voice input on browsers with no Web Speech API (Safari/iOS)
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=MAS Callnet HRMS

BILL_DB_HOST=127.0.0.1
BILL_DB_PORT=3306
BILL_DB_USER=your_bill_db_user
BILL_DB_PASSWORD=your_bill_db_password
BILL_DB_NAME=db_bill

DIALER_DB_HOST=127.0.0.1
DIALER_DB_PORT=3306
DIALER_DB_USER=your_dialer_db_user
DIALER_DB_PASSWORD=your_dialer_db_password
DIALER_DB_NAME=dialer_db

# MASMIS sales data (Neemans, Bellavita, GNC dashboards and uploads).
# Leave these blank if db_masmis lives on the same server as mas_hrms — each one falls back
# to the corresponding DB_* value. Set them when it does not: the sales-upload module was
# entirely non-functional because the code could only ever reach db_masmis on the mas_hrms
# host, where the application user has no grant.
MASMIS_DB_HOST=
MASMIS_DB_PORT=
MASMIS_DB_USER=
MASMIS_DB_PASSWORD=
MASMIS_DB_NAME=db_masmis

LEGACY_MYSQL_HOST=127.0.0.1
LEGACY_MYSQL_PORT=3306
LEGACY_MYSQL_USER=your_legacy_user
LEGACY_MYSQL_PASSWORD=your_legacy_password
LEGACY_MYSQL_DATABASE=db_bill
LEGACY_MYSQL_LOCAL_ADDRESS=

LMS_DB_HOST=127.0.0.1
LMS_DB_PORT=3306
LMS_DB_USER=your_lms_user
LMS_DB_PASSWORD=your_lms_password
LMS_DB_NAME=lms_mcn

NCOSEC_DB_HOST=127.0.0.1
NCOSEC_DB_PORT=1433
NCOSEC_DB_USER=your_ncosec_user
NCOSEC_DB_PASSWORD=your_ncosec_password
NCOSEC_DB_NAME=NCOSEC
NCOSEC_DB_ENCRYPT=false

BGV_WEBHOOK_SECRET=replace-with-bgv-webhook-secret
# Required when penny-drop webhook provider is active (optional otherwise)
PENNY_DROP_WEBHOOK_SECRET=
ATS_FORM_API_KEY=replace-with-ats-form-api-key
INFINITY_AI_API_KEY=
DIGIO_CLIENT_ID=
DIGIO_CLIENT_SECRET=
LUCKPAY_ENV=staging
LUCKPAY_BASE_URL=https://staging-api-banking.luckpay.in/apibanking/api/v1
LUCKPAY_AUTH_URL=https://staging-api-banking.luckpay.in/apibanking/api/v1/auth/token
LUCKPAY_PROD_BASE_URL=https://api-banking.luckpay.in/apibanking/api/v1
LUCKPAY_BASIC_TOKEN=
LUCKPAY_CLIENT_ID=
LUCKPAY_WEBHOOK_SECRET=
LUCKPAY_TOKEN_CACHE_TTL_SECONDS=45
LUCKPAY_TIMEOUT_MS=60000
LUCKPAY_PROVIDER_ENABLED=false

# ── WhatsApp Notifications (choose ONE provider) ─────────────────────────────
# Option A: Twilio WhatsApp Business
# Set WHATSAPP_PROVIDER=twilio and fill in your Twilio credentials.
# Free sandbox: twilio.com/console/messaging/whatsapp/sandbox
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=+14155238886

# Option B: Meta / Facebook WhatsApp Cloud API
# Set WHATSAPP_PROVIDER=meta and fill in your Meta credentials.
# WHATSAPP_PROVIDER=meta
# META_WHATSAPP_ACCESS_TOKEN=your_meta_access_token
# META_WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Option C: Local WhatsApp API (e.g. whatsapp-web.js self-hosted)
# WHATSAPP_PROVIDER=local
# LOCAL_WHATSAPP_API_URL=http://localhost:3001
# LOCAL_WHATSAPP_API_KEY=your_local_api_key
# LOCAL_WHATSAPP_BUSINESS_NUMBER=+919999999999

# Events that trigger WhatsApp notifications (comma-separated, leave blank to disable)
# Available: leave_submitted,leave_decision,payslip_ready,salary_credited,
#            roster_published,onboarding_welcome,attendance_absent
WHATSAPP_ENABLED_EVENTS=leave_decision,payslip_ready,salary_credited

# ── Cloudinary (optional) — employee profile photo cloud storage ──────────────
# Free tier: 25 GB storage + 25 GB bandwidth/month, no credit card required
# Sign up at https://cloudinary.com/users/register_free
# When these 3 vars are set, photos are stored on Cloudinary instead of local disk.
# Leave blank to use local filesystem (default for local dev).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Report generation worker thresholds ───────────────────────────────────────
# Max rows per XLSX file. Requests exceeding this are failed with ROW_LIMIT_EXCEEDED.
REPORT_MAX_XLSX_ROWS=100000
# Max rows returned by the immediate-export endpoint (GET /api/reports/suite/:code/export).
REPORT_IMMEDIATE_EXPORT_ROWS=500
# Max XLSX attachment size in bytes (20 MB). Files above this trigger a secure download link.
REPORT_ATTACHMENT_MAX_BYTES=20971520
# File size at which a size warning is added to the email body (15 MB).
REPORT_LARGE_FILE_THRESHOLD_BYTES=15728640
# Rows fetched per DB chunk during worker generation (keyset pagination chunk size).
REPORT_WORKER_CHUNK_SIZE=5000
# Retention for restricted/highly_restricted reports (days). Must match privacy policy.
REPORT_RETENTION_RESTRICTED_DAYS=2
# Retention for internal/confidential reports (days).
REPORT_RETENTION_DEFAULT_DAYS=7
# TTL for secure single-use download tokens (hours). Capped at retention days.
REPORT_DOWNLOAD_TOKEN_TTL_HOURS=48
