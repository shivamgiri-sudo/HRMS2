# Copy to backend/.env.test before running the backend test suite:
#   cp backend/.env.test.example backend/.env.test
#
# Why this exists
# ---------------
# backend/.env points DB_HOST at the PRODUCTION mas_hrms host, and NODE_ENV
# there is "development". vitest.config.ts declares `envFile: ".env.test"`, so
# without this file a test run inherits the production connection details —
# one un-mocked query away from live payroll data.
#
# tests/setup.ts fails fast when it detects a production DB host, so a missing
# .env.test surfaces immediately with instructions rather than silently
# pointing the suite at production.
#
# The real fix is a staging database; this file is the guardrail until there
# is one.

NODE_ENV=test

# Deliberately unroutable — the suite mocks db.execute globally, so nothing
# should connect. This is the backstop for anything that tries.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mas_hrms_test
DB_USER=test
DB_PASSWORD=test

INTERNAL_DEMO_BYPASS=true
PORTAL_DEMO_BYPASS=true
