{
  // Scoped typecheck for the notification primitives.
  //
  // Only files with shallow import graphs belong here. Adding a module-level file such as
  // dispatch.service.ts pulls in the whole app graph: the check then runs 7+ minutes and
  // leaves an unkillable ~130MB orphan when interrupted. Verify those with vitest instead.
  //
  // Usage: npx tsc -p tsconfig.notif.json     (completes in seconds)
  "extends": "./tsconfig.json",
  "compilerOptions": { "noEmit": true },
  "include": [
    "src/shared/email-domains.ts",
    "src/shared/recipient-resolver.ts",
    "src/shared/recipient-resolver.types.ts",
    "src/shared/worker-config.ts",
    "src/modules/communication/notification.gateway.ts"
  ]
}
