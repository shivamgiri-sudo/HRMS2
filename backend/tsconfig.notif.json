{
  // Scoped typecheck for the notification primitives.
  //
  // Deliberately limited to leaf files with small import graphs. Adding a module-level
  // file such as dispatch.service.ts pulls in the whole app graph and the check runs for
  // 7+ minutes, then leaves an unkillable ~130MB orphan when it is interrupted. Verify
  // module-level edits with vitest instead.
  //
  // Usage: npx tsc -p tsconfig.notif.json     (completes in seconds)
  "extends": "./tsconfig.json",
  "compilerOptions": { "noEmit": true },
  "include": [
    "src/shared/email-domains.ts",
    "src/shared/recipient-resolver.ts",
    "src/shared/recipient-resolver.types.ts"
  ]
}
