{
  // Typecheck for the COSEC biometric sync worker.
  //
  // Deliberately NOT the repo-wide `tsc -p tsconfig.json`: that run is slow enough to be
  // killed mid-flight, and a killed run leaves ~350MB tsc processes behind that cannot be
  // reaped and starve the machine. Scope to the worker instead:
  //
  //     npx tsc -p tsconfig.cosec-check.json
  //
  // Transitively pulled-in modules are still checked, so pre-existing errors from other
  // people's files may appear; cosec-sync.worker.ts itself is expected to stay clean.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "src/modules/wfm/cosec-sync.worker.ts"
  ]
}
