<tr><td style="padding:6px 28px 0;font-size:13px;color:#475569">Something came up? <a href="https://x.test/w/0123456789abcdef0123456789abcdef?a=later" style="color:#1d4ed8">Ask for another time</a>.</td></tr>
<tr><td style="padding:14px 28px 0"><table role="presentation" width="100%" cellpadding="0" cellspacing="0">
<tr><td style="padding:10px 0;border-top:1px solid #e2e8f0;width:110px;color:#64748b;font-size:13px;vertical-align:top">Venue</td><td style="padding:10px 0;border-top:1px solid #e2e8f0;font-size:15px;color:#0f172a"><b>NOIDA-2</b><br/><span style="font-size:14px;color:#334155">C-27, Sector 62, Noida</span><br/><a href="https://maps.google.com/?q=28.6,77.3" style="font-size:14px;color:#1d4ed8">Get directions</a></td></tr>
<tr><td style="padding:10px 0;border-top:1px solid #e2e8f0;width:110px;color:#64748b;font-size:13px;vertical-align:top">Please carry</td><td style="padding:10px 0;border-top:1px solid #e2e8f0;font-size:15px;color:#0f172a"><ul style="margin:0;padding-left:18px"><li style="margin:2px 0">Aadhaar</li><li style="margin:2px 0">PAN</li><li style="margin:2px 0">12th marksheet</li></ul></td></tr>
<tr><td style="padding:10px 0;border-top:1px solid #e2e8f0;width:110px;color:#64748b;font-size:13px;vertical-align:top">Reference</td><td style="padding:10px 0;border-top:1px solid #e2e8f0;font-size:15px;color:#0f172a"><span style="font-family:Consolas,monospace">HE-ABC123</span> <span style="font-size:13px;color:#64748b">(show this at reception)</span></td></tr>
<tr><td style="padding:10px 0;border-top:1px solid #e2e8f0;width:110px;color:#64748b;font-size:13px;vertical-align:top">Questions</td><td style="padding:10px 0;border-top:1px solid #e2e8f0;font-size:15px;color:#0f172a">Riya 9999999999</td></tr></table></td></tr>
