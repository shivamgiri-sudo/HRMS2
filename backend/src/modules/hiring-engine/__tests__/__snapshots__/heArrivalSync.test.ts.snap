// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`arrival sync and no-show marking (pinned before the late-arrival change) > a passed slot becomes no_show with one recovery message for a first no-show > sql 1`] = `
[
  [
    "SELECT m.id, m.lead_id, m.drive_id FROM he_match m JOIN he_drive d ON d.id = m.drive_id AND d.drive_date = CURDATE() JOIN he_lead l ON l.id = m.lead_id JOIN ats_candidate c ON RIGHT(REGEXP_REPLACE(c.mobile, '[^0-9]', ''), 10) = l.mobile10 AND c.walk_in_date = CURDATE() WHERE m.state IN ('invited','confirmed')",
    [],
  ],
  [
    "SELECT m.id, m.lead_id, m.drive_id FROM he_match m WHERE m.state IN ('invited','confirmed') AND m.slot_at IS NOT NULL AND m.slot_at < DATE_SUB(NOW(), INTERVAL 120 MINUTE) AND m.slot_at > DATE_SUB(NOW(), INTERVAL 2 DAY)",
    [],
  ],
  [
    "UPDATE he_match SET state = 'no_show' WHERE id = ?",
    [
      "m2",
    ],
  ],
  [
    "SELECT COUNT(*) AS n FROM he_match WHERE lead_id = ? AND state = 'no_show'",
    [
      "L2",
    ],
  ],
]
`;

exports[`arrival sync and no-show marking (pinned before the late-arrival change) > an invited match with a same-day branch walk-in is marked arrived, with one timeline event > sql 1`] = `
[
  [
    "SELECT m.id, m.lead_id, m.drive_id FROM he_match m JOIN he_drive d ON d.id = m.drive_id AND d.drive_date = CURDATE() JOIN he_lead l ON l.id = m.lead_id JOIN ats_candidate c ON RIGHT(REGEXP_REPLACE(c.mobile, '[^0-9]', ''), 10) = l.mobile10 AND c.walk_in_date = CURDATE() WHERE m.state IN ('invited','confirmed')",
    [],
  ],
  [
    "UPDATE he_match SET state = 'arrived' WHERE id = ?",
    [
      "m1",
    ],
  ],
  [
    "SELECT m.id, m.lead_id, m.drive_id FROM he_match m WHERE m.state IN ('invited','confirmed') AND m.slot_at IS NOT NULL AND m.slot_at < DATE_SUB(NOW(), INTERVAL 120 MINUTE) AND m.slot_at > DATE_SUB(NOW(), INTERVAL 2 DAY)",
    [],
  ],
]
`;
