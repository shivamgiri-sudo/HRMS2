// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`calling file pin > SQL of one live batch for a slot, in order 1`] = `
[
  "SELECT param_key, value FROM he_model_param WHERE param_key LIKE 'policy.callfile%'",
  "SELECT id, status, TIMESTAMPDIFF(MINUTE, created_at, NOW()) AS age_min FROM qualified_followup_call_batch WHERE status IN ('pending','sending')",
  "INSERT INTO qualified_followup_call_batch (id, row_count, sent_to, status, mode_tag, slot_key, slot_claim) VALUES (?, 0, ?, 'pending', ?, ?, ?)",
  "SELECT qf.id, qf.source_type, qf.mobile10, qf.full_name, qf.role_name, qf.requisition_id, qf.branch_name, qf.origin_label, qf.qualified_at, qf.email_status, qf.email_sent_at, qf.wa_status, qf.wa_sent_at, (SELECT jr.requisition_code FROM job_requisition jr WHERE jr.id = qf.requisition_id COLLATE utf8mb4_unicode_ci LIMIT 1) AS requisition_code, (SELECT mc.campaign_name FROM meta_campaign mc WHERE mc.id = qf.campaign_id COLLATE utf8mb4_unicode_ci LIMIT 1) AS campaign_name, (SELECT bm.address FROM branch_master bm WHERE bm.branch_name COLLATE utf8mb4_unicode_ci = qf.branch_name COLLATE utf8mb4_unicode_ci AND bm.active_status = 1 LIMIT 1) AS address, CASE WHEN hb.id IS NOT NULL THEN DATE_FORMAT(hb.slot_at, '%Y-%m-%d') WHEN qf.source_type = 'he' THEN DATE_FORMAT(hm.slot_at, '%Y-%m-%d') ELSE mr.interview_date END AS slot_date, CASE WHEN hb.id IS NOT NULL THEN DATE_FORMAT(hb.slot_at, '%H:%i') WHEN qf.source_type = 'he' THEN DATE_FORMAT(hm.slot_at, '%H:%i') ELSE mr.interview_time END AS slot_time, qf.match_id, EXISTS (SELECT 1 FROM he_lead_event ev WHERE ev.lead_id = hl.id AND ev.event_type = 'exported_for_calling' AND ev.created_at > DATE_SUB(NOW(), INTERVAL 18 HOUR) AND COALESCE(ev.detail, '') NOT LIKE 'follow-up batch%') AS exported_recently, mr.voice_call_outcome AS meta_outcome, hl.status AS lead_status, (EXISTS (SELECT 1 FROM he_consent k WHERE k.lead_id = hl.id AND k.consent_type = 'whatsapp_contact' AND k.revoked_at IS NOT NULL) AND NOT EXISTS (SELECT 1 FROM he_consent k2 WHERE k2.lead_id = hl.id AND k2.consent_type = 'whatsapp_contact' AND k2.revoked_at IS NULL)) AS consent_revoked, (SELECT GROUP_CONCAT(DISTINCT m2.state) FROM he_match m2 WHERE m2.lead_id = hl.id AND m2.state IN ('confirmed','arrived','selected')) AS match_states, EXISTS (SELECT 1 FROM he_match m3 WHERE m3.lead_id = hl.id AND m3.requisition_id = qf.requisition_id COLLATE utf8mb4_unicode_ci AND m3.state = 'declined') AS row_declined, (SELECT COUNT(*) FROM he_call c WHERE c.lead_id = hl.id) AS calls_n, (SELECT COUNT(*) FROM he_call c WHERE c.lead_id = hl.id AND c.outcome IS NOT NULL AND c.outcome <> 'NO_ANSWER' AND c.outcome NOT LIKE 'CALL_FAILED%') AS calls_answered, (SELECT COUNT(*) FROM he_call c WHERE c.lead_id = hl.id AND (c.outcome = 'NO_ANSWER' OR c.outcome LIKE 'CALL_FAILED%')) AS calls_retryable, (SELECT MAX(c.created_at) FROM he_call c WHERE c.lead_id = hl.id) AS last_call_at, (SELECT COUNT(DISTINCT p.call_file_batch_id) FROM qualified_followup p WHERE p.mobile10 = qf.mobile10 AND p.mode_at_enqueue = qf.mode_at_enqueue AND p.call_file_batch_id IS NOT NULL) AS files_n, (SELECT MAX(b.created_at) FROM qualified_followup p JOIN qualified_followup_call_batch b ON b.id = p.call_file_batch_id WHERE p.mobile10 = qf.mobile10 AND p.mode_at_enqueue = qf.mode_at_enqueue AND p.call_file_batch_id IS NOT NULL) AS last_file_at FROM qualified_followup qf LEFT JOIN meta_lead_raw mr ON mr.id COLLATE utf8mb4_unicode_ci = qf.meta_lead_id COLLATE utf8mb4_unicode_ci LEFT JOIN he_match hm ON hm.lead_id COLLATE utf8mb4_unicode_ci = qf.he_lead_id COLLATE utf8mb4_unicode_ci AND hm.drive_id COLLATE utf8mb4_unicode_ci = qf.drive_id COLLATE utf8mb4_unicode_ci LEFT JOIN he_match hb ON hb.id = qf.match_id COLLATE utf8mb4_unicode_ci LEFT JOIN he_lead hl ON hl.mobile10 = qf.mobile10 COLLATE utf8mb4_unicode_ci WHERE qf.call_state = 'in_file' AND qf.call_file_batch_id IS NULL AND qf.stopped_reason IS NULL AND qf.mode_at_enqueue = ? AND qf.owner = 'pipeline' ORDER BY qf.created_at, qf.id LIMIT 5000",
  "SELECT qf.id, qf.mobile10, qf.requisition_id, qf.source_type, jr.requisition_code, qf.qualified_at, (qf.email_status IS NOT NULL OR qf.wa_status IS NOT NULL OR qf.call_state <> 'pending') AS started, hm.state = 'declined' AS declined, hm.distance_km, hm.score, jr.requested_headcount - jr.fulfilled_headcount AS remaining FROM qualified_followup qf LEFT JOIN he_lead hl ON hl.mobile10 = qf.mobile10 LEFT JOIN he_match hm ON hm.lead_id = hl.id AND hm.requisition_id = qf.requisition_id LEFT JOIN job_requisition jr ON jr.id = qf.requisition_id COLLATE utf8mb4_unicode_ci WHERE qf.mobile10 IN (?) AND qf.mode_at_enqueue = ? AND qf.owner = 'pipeline' AND qf.stopped_reason IS NULL",
  "UPDATE qualified_followup SET call_file_batch_id = ? WHERE id IN (?) AND call_file_batch_id IS NULL AND call_state = 'in_file' AND stopped_reason IS NULL",
  "UPDATE qualified_followup_call_batch SET status = 'sending', row_count = ?, summary = ? WHERE id = ?",
  "UPDATE qualified_followup_call_batch SET status = 'sent', row_count = ? WHERE id = ?",
  "SELECT id FROM meta_lead_raw WHERE RIGHT(REGEXP_REPLACE(parsed_phone, '[^0-9]', ''), 10) = ? ORDER BY (screening_result = 'qualified') DESC, created_at DESC LIMIT 1",
  "SELECT id, sources_json FROM he_lead WHERE mobile10 = ? LIMIT 1",
  "INSERT INTO he_lead (mobile10, full_name, email, age, education_rank, experience_years, night_shift_ok, pincode, locality, primary_source, sources_json, ats_candidate_id, meta_lead_id) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?) ON DUPLICATE KEY UPDATE id = id",
  "SELECT id FROM he_lead WHERE mobile10 = ? LIMIT 1",
]
`;

exports[`calling file pin > batch schedule 1`] = `
[
  "10:00",
  "12:00",
  "14:00",
  "16:00",
  "18:00",
]
`;
