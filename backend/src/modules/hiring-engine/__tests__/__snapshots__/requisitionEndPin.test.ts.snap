// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`end-date pins (switch off) > auto-close reads streams with their requisition and closes by the window 1`] = `
{
  "out": [
    {
      "reason": "window_ended",
      "requisitionId": "r1",
      "streamId": "s1",
    },
  ],
  "statements": [
    "SELECT s.*, jr.approval_status, jr.active_status, jr.requested_headcount, jr.fulfilled_headcount, jr.id AS jr_id FROM requisition_stream s LEFT JOIN job_requisition jr ON jr.id = s.requisition_id COLLATE utf8mb4_unicode_ci WHERE s.status IN ('open','paused') ORDER BY s.created_at, s.id",
    "SELECT stream_id, day, kind FROM requisition_stream_day WHERE stream_id IN (?) ORDER BY day",
  ],
}
`;

exports[`end-date pins (switch off) > first invites of a drive: the statements before any send 1`] = `
{
  "considered": 0,
  "statements": [
    "SELECT value FROM he_model_param WHERE param_key = ? LIMIT 1",
    "SELECT m.id, m.lead_id, l.full_name, l.mobile10, (l.last_contact_at IS NOT NULL AND l.last_contact_at < DATE_SUB(NOW(), INTERVAL 30 DAY)) AS dormant, (l.email IS NOT NULL AND l.email <> '') AS has_email, COALESCE((SELECT cfg.email_on FROM he_lead_campaign lc JOIN he_campaign_config cfg ON cfg.campaign_id = lc.campaign_id WHERE lc.lead_id = m.lead_id ORDER BY lc.form_filled_at DESC LIMIT 1), 1) AS email_on, COALESCE((SELECT cfg.whatsapp_on FROM he_lead_campaign lc JOIN he_campaign_config cfg ON cfg.campaign_id = lc.campaign_id WHERE lc.lead_id = m.lead_id ORDER BY lc.form_filled_at DESC LIMIT 1), 1) AS whatsapp_on, (EXISTS (SELECT 1 FROM he_consent c WHERE c.lead_id = m.lead_id AND c.consent_type = 'whatsapp_contact' AND c.revoked_at IS NULL) OR (? = 0 AND NOT EXISTS (SELECT 1 FROM he_consent c2 WHERE c2.lead_id = m.lead_id AND c2.consent_type = 'whatsapp_contact' AND c2.revoked_at IS NOT NULL))) AS has_consent FROM he_match m JOIN he_lead l ON l.id = m.lead_id WHERE m.drive_id = ? AND m.state = 'suggested' AND l.status <> 'opted_out' AND NOT EXISTS (SELECT 1 FROM qualified_followup qf WHERE qf.mobile10 = l.mobile10 COLLATE utf8mb4_unicode_ci AND qf.owner = 'pipeline' AND qf.mode_at_enqueue IN ('live','canary') AND qf.stopped_reason IS NULL AND (qf.requisition_id = m.requisition_id COLLATE utf8mb4_unicode_ci OR qf.journey_state IN ('reach','engaged','confirmed','reminded'))) AND NOT EXISTS (SELECT 1 FROM qualified_followup qs WHERE qs.mobile10 = l.mobile10 COLLATE utf8mb4_unicode_ci AND qs.requisition_id = m.requisition_id COLLATE utf8mb4_unicode_ci AND qs.mode_at_enqueue IN ('live','canary') AND qs.stopped_reason IN ('criteria_failed','requisition_closed','opted_out')) AND NOT EXISTS (SELECT 1 FROM followup_person fp WHERE fp.mobile10 = l.mobile10 COLLATE utf8mb4_unicode_ci AND fp.last_first_contact_at > DATE_SUB(NOW(), INTERVAL 7 DAY)) ORDER BY has_email DESC, m.score DESC LIMIT ?",
    "SELECT COUNT(*) AS n FROM he_template WHERE template_key LIKE 'he_walkin_invite:%' AND approval_state = 'approved'",
  ],
}
`;
