// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`getRequisitionSources SQL (pinned) > issues the same statements and parameters as before the window read model 1`] = `
[
  [
    "SELECT requisition_code, branch_name, designation_name FROM job_requisition WHERE id = ? LIMIT 1",
    [
      "r1",
    ],
  ],
  [
    "SELECT param_key FROM he_model_param WHERE param_key LIKE ? AND value = 1",
    [
      "meta.live_from.%",
    ],
  ],
  [
    "SELECT id, source_type, origin_id, origin_label, status FROM requisition_stream WHERE requisition_id = ?",
    [
      "r1",
    ],
  ],
  [
    "
SELECT f.source_type, f.origin_id, MAX(f.origin_label) AS origin_label,
       COUNT(*) AS qualified, SUM(f.emailed) AS emailed, SUM(f.whatsapped) AS whatsapped, SUM(f.replied) AS replied, SUM(f.called) AS called,
       SUM(f.confirmed) AS confirmed, SUM(f.arrived) AS arrived, SUM(f.selected) AS selected, SUM(f.joined) AS joined
  FROM (
    SELECT qf.source_type, qf.origin_id, qf.origin_label,
           CASE WHEN qf.email_status = 'sent' OR EXISTS (SELECT 1 FROM he_message hm WHERE hm.requisition_id = qf.requisition_id AND hm.lead_id = qf.he_lead_id
                  AND hm.channel = 'email' AND hm.direction = 'out' AND hm.delivery_status <> 'failed') THEN 1 ELSE 0 END AS emailed,
           CASE WHEN qf.wa_status = 'sent' OR EXISTS (SELECT 1 FROM he_message hm WHERE hm.requisition_id = qf.requisition_id AND hm.lead_id = qf.he_lead_id
                  AND hm.channel = 'whatsapp' AND hm.direction = 'out' AND hm.delivery_status <> 'failed') THEN 1 ELSE 0 END AS whatsapped,
           CASE WHEN qf.stopped_reason = 'replied'
                  OR EXISTS (SELECT 1 FROM he_message hi WHERE hi.lead_id = qf.he_lead_id AND hi.direction = 'in' AND hi.created_at > qf.qualified_at)
                  OR EXISTS (SELECT 1 FROM meta_lead_messages mm WHERE mm.lead_id = qf.meta_lead_id COLLATE utf8mb4_unicode_ci AND mm.direction = 'inbound' AND mm.created_at > qf.qualified_at)
                THEN 1 ELSE 0 END AS replied,
           CASE WHEN qf.call_state = 'called' OR (m.id IS NOT NULL AND EXISTS (SELECT 1 FROM he_call c WHERE c.lead_id = m.lead_id AND c.match_id = m.id)) THEN 1 ELSE 0 END AS called,
           CASE WHEN m.state IN ('confirmed','arrived','selected') THEN 1 ELSE 0 END AS confirmed,
           CASE WHEN m.state IN ('arrived','selected') THEN 1 ELSE 0 END AS arrived,
           CASE WHEN (m.state IN ('arrived','selected') AND ((hl.status = 'joined' AND hl.status_at >= md.drive_date) OR (LOWER(ac.current_stage) IN ('joined','payroll_validated') AND (EXISTS (SELECT 1 FROM ats_candidate_stage_log sl WHERE sl.candidate_id = ac.id AND LOWER(sl.to_stage) IN ('joined','payroll_validated') AND sl.stage_date >= md.drive_date) OR EXISTS (SELECT 1 FROM ats_onboarding_bridge ob WHERE ob.candidate_id = ac.id AND ob.joining_date >= md.drive_date))))) THEN 1 ELSE 0 END AS joined,
           CASE WHEN ((m.state IN ('arrived','selected') AND ((hl.status = 'joined' AND hl.status_at >= md.drive_date) OR (LOWER(ac.current_stage) IN ('joined','payroll_validated') AND (EXISTS (SELECT 1 FROM ats_candidate_stage_log sl WHERE sl.candidate_id = ac.id AND LOWER(sl.to_stage) IN ('joined','payroll_validated') AND sl.stage_date >= md.drive_date) OR EXISTS (SELECT 1 FROM ats_onboarding_bridge ob WHERE ob.candidate_id = ac.id AND ob.joining_date >= md.drive_date))))) OR (m.state IN ('arrived','selected') AND ((m.state = 'selected' AND m.updated_at >= md.drive_date) OR (LOWER(ac.current_stage) IN ('selected','offered','offer','offer_approved','onboarded','converted') AND EXISTS (SELECT 1 FROM ats_candidate_stage_log sl WHERE sl.candidate_id = ac.id AND LOWER(sl.to_stage) IN ('selected','offered','offer','offer_approved','onboarded','converted','joined','payroll_validated') AND sl.stage_date >= md.drive_date))))) THEN 1 ELSE 0 END AS selected
      FROM qualified_followup qf
      LEFT JOIN he_match m ON m.lead_id = qf.he_lead_id AND m.requisition_id = qf.requisition_id
      LEFT JOIN he_drive md ON md.id = m.drive_id AND md.requisition_id = m.requisition_id
      LEFT JOIN he_lead hl ON hl.id = qf.he_lead_id
      LEFT JOIN ats_candidate ac ON ac.id = COALESCE(qf.ats_candidate_id, hl.ats_candidate_id) COLLATE utf8mb4_unicode_ci
     WHERE qf.requisition_id = ?
  ) f
 GROUP BY f.source_type, f.origin_id",
    [
      "r1",
    ],
  ],
  [
    "
SELECT x.source_type,
       COALESCE(x.stream_origin_id, IF(x.source_type = 'he', 'pool', x.drive_id)) AS origin_id,
       MAX(COALESCE(x.stream_origin_label, IF(x.source_type = 'he', 'Pool: ATS history', COALESCE(x.run_label, CONCAT('Re-run ', DATE_FORMAT(x.drive_date, '%Y-%m-%d')))))) AS origin_label,
       COUNT(DISTINCT x.lead_id) AS leads
  FROM (
    SELECT d.requisition_id, d.id AS drive_id, d.run_label, d.drive_date, rs.origin_id AS stream_origin_id, rs.origin_label AS stream_origin_label, m.lead_id,
           CASE WHEN COALESCE(rs.source_type, 'he') <> 'he' OR COALESCE(d.source_kind, 'pool') <> 'pool' OR (al.meta_lead_id IS NOT NULL OR EXISTS (SELECT 1 FROM he_lead_campaign alx WHERE alx.lead_id = al.id)) THEN IF(((alf.created_at >= TIMESTAMP '2026-10-08 00:00:00' AND LEAST(alf.created_at, COALESCE(IF(alf.raw_payload->>'$.created_time' REGEXP '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{4}$', CONVERT_TZ(STR_TO_DATE(LEFT(alf.raw_payload->>'$.created_time', 19), '%Y-%m-%dT%H:%i:%s'), CONCAT(SUBSTRING(alf.raw_payload->>'$.created_time', 20, 3), ':', SUBSTRING(alf.raw_payload->>'$.created_time', 23, 2)), '+05:30'), NULL), alf.created_at)) >= TIMESTAMP '2026-10-08 00:00:00') OR EXISTS (SELECT 1 FROM he_lead_campaign alc JOIN meta_lead_raw afr ON afr.id = alc.meta_lead_id COLLATE utf8mb4_unicode_ci WHERE alc.lead_id = al.id AND (alc.form_filled_at IS NULL OR alc.form_filled_at >= TIMESTAMP '2026-10-08 00:00:00') AND LEAST(afr.created_at, COALESCE(IF(afr.raw_payload->>'$.created_time' REGEXP '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{4}$', CONVERT_TZ(STR_TO_DATE(LEFT(afr.raw_payload->>'$.created_time', 19), '%Y-%m-%dT%H:%i:%s'), CONCAT(SUBSTRING(afr.raw_payload->>'$.created_time', 20, 3), ':', SUBSTRING(afr.raw_payload->>'$.created_time', 23, 2)), '+05:30'), NULL), afr.created_at)) >= TIMESTAMP '2026-10-08 00:00:00')), 'meta_live', 'meta_old') ELSE 'he' END AS source_type
      FROM he_drive d
      JOIN he_match m ON m.drive_id = d.id AND m.requisition_id = d.requisition_id
      LEFT JOIN requisition_stream_match sm ON sm.match_id = m.id
  LEFT JOIN requisition_stream rs ON rs.id = sm.stream_id AND rs.requisition_id = d.requisition_id
  LEFT JOIN he_lead al ON al.id = m.lead_id
  LEFT JOIN meta_lead_raw alf ON alf.id = al.meta_lead_id COLLATE utf8mb4_unicode_ci
     WHERE d.requisition_id = ?
  ) x
 WHERE x.source_type <> 'meta_live'
 GROUP BY 1, 2",
    [
      "r1",
    ],
  ],
  [
    "SELECT id, campaign_name FROM meta_campaign WHERE requisition_id = ?",
    [
      "r1",
    ],
  ],
  [
    "SELECT r.campaign_id, IF(r.created_at >= TIMESTAMP '2026-10-08 00:00:00' AND LEAST(r.created_at, COALESCE(IF(r.raw_payload->>'$.created_time' REGEXP '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{4}$', CONVERT_TZ(STR_TO_DATE(LEFT(r.raw_payload->>'$.created_time', 19), '%Y-%m-%dT%H:%i:%s'), CONCAT(SUBSTRING(r.raw_payload->>'$.created_time', 20, 3), ':', SUBSTRING(r.raw_payload->>'$.created_time', 23, 2)), '+05:30'), NULL), r.created_at)) >= TIMESTAMP '2026-10-08 00:00:00', 'meta_live', 'meta_old') AS source_type, COUNT(DISTINCT RIGHT(REGEXP_REPLACE(r.parsed_phone, '[^0-9]', ''), 10)) AS leads
     FROM meta_lead_raw r
    WHERE r.campaign_id IN (?) AND (r.requisition_id IS NULL OR r.requisition_id = ?) AND r.parsed_phone IS NOT NULL
    GROUP BY r.campaign_id, source_type",
    [
      "c9",
      "r1",
    ],
  ],
]
`;
