 m.id LEFT JOIN requisition_stream_match sm ON sm.match_id = m.id LEFT JOIN requisition_stream rs ON rs.id = sm.stream_id AND rs.requisition_id = d.requisition_id LEFT JOIN he_lead al ON al.id = m.lead_id LEFT JOIN meta_lead_raw alf ON alf.id = al.meta_lead_id COLLATE utf8mb4_unicode_ci WHERE d.requisition_id IN (?) AND d.drive_date BETWEEN ? AND ? AND r.outcome = m.state GROUP BY 1, r.outcome, r.reason_code",
