exports[`source-typed statements (pinned) > insight facts 1`] = `
[
  [
    "SELECT param_key FROM he_model_param WHERE param_key LIKE ? AND value = 1",
    [
      "meta.live_from.%",
    ],
  ],
  [
    "SELECT /*+ MAX_EXECUTION_TIME(8000) */ STRAIGHT_JOIN m.lead_id AS tl, (COALESCE(rs.source_type, 'he') <> 'he' OR (d.source_kind IN ('meta','campaign') OR (d.source_kind = 'batch' AND EXISTS (SELECT 1 FROM he_import_batch hib WHERE hib.source = 'meta' AND JSON_CONTAINS(d.source_ids, JSON_QUOTE(hib.id)))))) AS tm, (d.drive_date >= TIMESTAMP '2026-10-08 00:00:00') AS tr, o.id AS oid, MAX(LEAST(ABS(HOUR(o.created_at) - CAST(li.best_hour_ist AS SIGNED)), 24 - ABS(HOUR(o.created_at) - CAST(li.best_hour_ist AS SIGNED))) > ?) AS outside, MAX(EXISTS (SELECT 1 FROM he_message i WHERE i.lead_id = m.lead_id AND i.direction = 'in' AND i.created_at > o.created_at AND i.created_at <= DATE_ADD(o.created_at, INTERVAL 24 HOUR))) AS hit FROM he_drive d JOIN he_match m ON m.drive_id = d.id AND m.requisition_id = d.requisition_id LEFT JOIN requisition_stream_match sm ON sm.match_id = m.id LEFT JOIN requisition_stream rs ON rs.id = sm.stream_id AND rs.requisition_id = d.requisition_id JOIN he_message o ON o.lead_id = m.lead_id AND o.direction = 'out' AND o.channel IN ('email','whatsapp') AND o.template_key LIKE 'he_walkin_invite%' AND o.created_at >= ? AND o.created_at < ? JOIN he_lead_insight li ON li.lead_id = m.lead_id AND li.best_hour_ist IS NOT NULL WHERE d.requisition_id IN (?) AND d.drive_date BETWEEN ? AND ? GROUP BY tl, tm, tr, o.id",
    [
      1,
      "2026-10-01 00:00:00",
      "2026-10-15 00:00:00",
      "r1",
      "2026-10-01",
      "2026-10-14",
