exports[`source-typed statements (pinned) > outcome reason counts 1`] = `
[
  [
    "SELECT param_key FROM he_model_param WHERE param_key LIKE ? AND value = 1",
    [
      "meta.live_from.%",
    ],
  ],
  [
    "SELECT /*+ MAX_EXECUTION_TIME(8000) */ m.lead_id AS tl, (COALESCE(rs.source_type, 'he') <> 'he' OR (d.source_kind IN ('meta','campaign') OR (d.source_kind = 'batch' AND EXISTS (SELECT 1 FROM he_import_batch hib WHERE hib.source = 'meta' AND JSON_CONTAINS(d.source_ids, JSON_QUOTE(hib.id)))))) AS tm, (d.drive_date >= TIMESTAMP '2026-10-08 00:00:00') AS tr, r.outcome, r.reason_code, COUNT(*) AS n FROM he_drive d JOIN he_match m ON m.drive_id = d.id AND m.requisition_id = d.requisition_id AND m.state IN ('no_show','declined') JOIN he_match_outcome_reason r ON r.match_id = m.id LEFT JOIN requisition_stream_match sm ON sm.match_id = m.id LEFT JOIN requisition_stream rs ON rs.id = sm.stream_id AND rs.requisition_id = d.requisition_id WHERE d.requisition_id IN (?) AND d.drive_date BETWEEN ? AND ? AND r.outcome = m.state GROUP BY tl, tm, tr, r.outcome, r.reason_code",
    [
      "r1",
      "2026-10-01",
      "2026-10-14",
    ],
  ],
]
`;

exports[`source-typed statements (pinned) > sources window 1`] = `
[
  [
    "SELECT param_key FROM he_model_param WHERE param_key LIKE ? AND value = 1",
    [
      "meta.live_from.%",
    ],
  ],
  [
    "SELECT /*+ MAX_EXECUTION_TIME(8000) */ requisition_id, id, source_type, origin_id, origin_label, status FROM requisition_stream WHERE requisition_id IN (?)",
    [
      "r1",
    ],
  ],
  [
    "SELECT /*+ MAX_EXECUTION_TIME(8000) */ f.cur, f.requisition_id, f.tl, f.tm, f.tr, f.tx, f.origin_id, MAX(f.origin_label) AS origin_label, COUNT(*) AS qualified, SUM(f.emailed) AS emailed, SUM(f.whatsapped) AS whatsapped, SUM(f.replied) AS replied, SUM(f.called) AS called, SUM(f.confirmed) AS confirmed, SUM(f.arrived) AS arrived, SUM(f.selected) AS selected, SUM(f.joined) AS joined FROM ( SELECT (qf.qualified_at >= ?) AS cur, qf.requisition_id, hl.id AS tl, ((qd.source_kind IN ('meta','campaign') OR (qd.source_kind = 'batch' AND EXISTS (SELECT 1 FROM he_import_batch hib WHERE hib.source = 'meta' AND JSON_CONTAINS(qd.source_ids, JSON_QUOTE(hib.id))))) OR qf.meta_lead_id IS NOT NULL) AS tm, (qf.qualified_at >= TIMESTAMP '2026-10-08 00:00:00') AS tr, IF(hl.meta_lead_id IS NULL, ((hlf.id IS NULL OR (hlf.created_at >= TIMESTAMP '2026-10-08 00:00:00' AND LEAST(hlf.created_at, COALESCE(IF(hlf.raw_payload->>'$.created_time' REGEXP '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{4}$', CONVERT_TZ(STR_TO_DATE(LEFT(hlf.raw_payload->>'$.created_time', 19), '%Y-%m-%dT%H:%i:%s'), CONCAT(SUBSTRING(hlf.raw_payload->>'$.created_time', 20, 3), ':', SUBSTRING(hlf.raw_payload->>'$.created_time', 23, 2)), '+05:30'), NULL), hlf.created_at)) >= TIMESTAMP '2026-10-08 00:00:00')) AND (hlf.id IS NOT NULL OR EXISTS (SELECT 1 FROM he_lead_campaign aly WHERE aly.lead_id = hl.id)) AND NOT EXISTS (SELECT 1 FROM he_lead_campaign alc JOIN meta_lead_raw afr ON afr.id = alc.meta_lead_id COLLATE utf8mb4_unicode_ci WHERE alc.lead_id = hl.id AND (alc.form_filled_at < TIMESTAMP '2026-10-08 00:00:00' OR afr.created_at < TIMESTAMP '2026-10-08 00:00:00' OR LEAST(afr.created_at, COALESCE(IF(afr.raw_payload->>'$.created_time' REGEXP '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{4}$', CONVERT_TZ(STR_TO_DATE(LEFT(afr.raw_payload->>'$.created_time', 19), '%Y-%m-%dT%H:%i:%s'), CONCAT(SUBSTRING(afr.raw_payload->>'$.created_time', 20, 3), ':', SUBSTRING(afr.raw_payload->>'$.created_time', 23, 2)), '+05:30'), NULL), afr.created_at)) < TIMESTAMP '2026-10-08 00:00:00'))), NULL) AS tx, qf.origin_id, qf.origin_label, CASE WHEN qf.email_status = 'sent' OR EXISTS (SELECT 1 FROM he_message hm WHERE hm.requisition_id = qf.requisition_id AND hm.lead_id = qf.he_lead_id AND hm.channel = 'email' AND hm.direction = 'out' AND hm.delivery_status <> 'failed') THEN 1 ELSE 0 END AS emailed, CASE WHEN qf.wa_status = 'sent' OR EXISTS (SELECT 1 FROM he_message hm WHERE hm.requisition_id = qf.requisition_id AND hm.lead_id = qf.he_lead_id AND hm.channel = 'whatsapp' AND hm.direction = 'out' AND hm.delivery_status <> 'failed') THEN 1 ELSE 0 END AS whatsapped, CASE WHEN qf.stopped_reason = 'replied' OR EXISTS (SELECT 1 FROM he_message hi WHERE hi.lead_id = qf.he_lead_id AND hi.direction = 'in' AND hi.created_at > qf.qualified_at) OR EXISTS (SELECT 1 FROM meta_lead_messages mm WHERE mm.lead_id = qf.meta_lead_id COLLATE utf8mb4_unicode_ci AND mm.direction = 'inbound' AND mm.created_at > qf.qualified_at) THEN 1 ELSE 0 END AS replied, CASE WHEN qf.call_state = 'called' OR (m.id IS NOT NULL AND EXISTS (SELECT 1 FROM he_call c WHERE c.lead_id = m.lead_id AND c.match_id = m.id)) THEN 1 ELSE 0 END AS called, CASE WHEN m.state IN ('confirmed','arrived','selected') THEN 1 ELSE 0 END AS confirmed, CASE WHEN m.state IN ('arrived','selected') THEN 1 ELSE 0 END AS arrived, CASE WHEN (m.state IN ('arrived','selected') AND ((hl.status = 'joined' AND hl.status_at >= md.drive_date) OR (LOWER(ac.current_stage) IN ('joined','payroll_validated') AND (EXISTS (SELECT 1 FROM ats_candidate_stage_log sl WHERE sl.candidate_id = ac.id AND LOWER(sl.to_stage) IN ('joined','payroll_validated') AND sl.stage_date >= md.drive_date) OR EXISTS (SELECT 1 FROM ats_onboarding_bridge ob WHERE ob.candidate_id = ac.id AND ob.joining_date >= md.drive_date))))) THEN 1 ELSE 0 END AS joined, CASE WHEN ((m.state IN ('arrived','selected') AND ((hl.status = 'joined' AND hl.status_at >= md.drive_date) OR (LOWER(ac.current_stage) IN ('joined','payroll_validated') AND (EXISTS (SELECT 1 FROM ats_candidate_stage_log sl WHERE sl.candidate_id = ac.id AND LOWER(sl.to_stage) IN ('joined','payroll_validated') AND sl.stage_date >= md.drive_date) OR EXISTS (SELECT 1 FROM ats_onboarding_bridge ob WHERE ob.candidate_id = ac.id AND ob.joining_date >= md.drive_date))))) OR (m.state IN ('arrived','selected') AND ((m.state = 'selected' AND m.updated_at >= md.drive_date) OR (LOWER(ac.current_stage) IN ('selected','offered','offer','offer_approved','onboarded','converted') AND EXISTS (SELECT 1 FROM ats_candidate_stage_log sl WHERE sl.candidate_id = ac.id AND LOWER(sl.to_stage) IN ('selected','offered','offer','offer_approved','onboarded','converted','joined','payroll_validated') AND sl.stage_date >= md.drive_date))))) THEN 1 ELSE 0 END AS selected FROM qualified_followup qf LEFT JOIN he_match m ON m.lead_id = qf.he_lead_id AND m.requisition_id = qf.requisition_id LEFT JOIN he_drive md ON md.id = m.drive_id AND md.requisition_id = m.requisition_id LEFT JOIN he_lead hl ON hl.id = qf.he_lead_id LEFT JOIN ats_candidate ac ON ac.id = COALESCE(qf.ats_candidate_id, hl.ats_candidate_id) COLLATE utf8mb4_unicode_ci LEFT JOIN he_drive qd ON qd.id = COALESCE(qf.drive_id, m.drive_id) LEFT JOIN meta_lead_raw hlf ON hlf.id = COALESCE(hl.meta_lead_id, qf.meta_lead_id) COLLATE utf8mb4_unicode_ci WHERE qf.requisition_id IN (?) AND qf.qualified_at >= ? AND qf.qualified_at < ? ) f GROUP BY f.requisition_id, f.tl, f.tm, f.tr, f.tx, f.origin_id, f.cur",
    [
      "2026-10-01 00:00:00",
      "r1",
      "2026-10-01 00:00:00",
      "2026-10-15 00:00:00",
    ],
  ],
  [
    "SELECT /*+ MAX_EXECUTION_TIME(8000) */ 'f' AS src, MD5(f.person) AS pkey, f.requisition_id, MAX(CONCAT(4 - f.ft, 3, CHAR(31), 'campaign', CHAR(31), f.campaign_id, CHAR(31), COALESCE(f.campaign_name, ''))) COLLATE utf8mb4_unicode_ci AS fkey, NULL AS tl, NULL AS tm, NULL AS tr, NULL AS sid, NULL AS so_id, NULL AS so_label, NULL AS drive_id, NULL AS dlabel FROM (SELECT RIGHT(REGEXP_REPLACE(r.parsed_phone, '[^0-9]', ''), 10) COLLATE utf8mb4_unicode_ci AS person, mc.requisition_id COLLATE utf8mb4_unicode_ci AS requisition_id, FIELD(IF(r.created_at >= TIMESTAMP '2026-10-08 00:00:00' AND LEAST(r.created_at, COALESCE(IF(r.raw_payload->>'$.created_time' REGEXP '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{4}$', CONVERT_TZ(STR_TO_DATE(LEFT(r.raw_payload->>'$.created_time', 19), '%Y-%m-%dT%H:%i:%s'), CONCAT(SUBSTRING(r.raw_payload->>'$.created_time', 20, 3), ':', SUBSTRING(r.raw_payload->>'$.created_time', 23, 2)), '+05:30'), NULL), r.created_at)) >= TIMESTAMP '2026-10-08 00:00:00' AND IF(EXISTS (SELECT 1 FROM he_lead pl WHERE pl.mobile10 = RIGHT(REGEXP_REPLACE(r.parsed_phone, '[^0-9]', ''), 10) COLLATE utf8mb4_unicode_ci), EXISTS (SELECT 1 FROM he_lead pl LEFT JOIN meta_lead_raw plf ON plf.id = pl.meta_lead_id COLLATE utf8mb4_unicode_ci WHERE pl.mobile10 = RIGHT(REGEXP_REPLACE(r.parsed_phone, '[^0-9]', ''), 10) COLLATE utf8mb4_unicode_ci AND ((plf.id IS NULL OR (plf.created_at >= TIMESTAMP '2026-10-08 00:00:00' AND LEAST(plf.created_at, COALESCE(IF(plf.raw_payload->>'$.created_time' REGEXP '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{4}$', CONVERT_TZ(STR_TO_DATE(LEFT(plf.raw_payload->>'$.created_time', 19), '%Y-%m-%dT%H:%i:%s'), CONCAT(SUBSTRING(plf.raw_payload->>'$.created_time', 20, 3), ':', SUBSTRING(plf.raw_payload->>'$.created_time', 23, 2)), '+05:30'), NULL), plf.created_at)) >= TIMESTAMP '2026-10-08 00:00:00')) AND (plf.id IS NOT NULL OR EXISTS (SELECT 1 FROM he_lead_campaign aly WHERE aly.lead_id = pl.id)) AND NOT EXISTS (SELECT 1 FROM he_lead_campaign alc JOIN meta_lead_raw afr ON afr.id = alc.meta_lead_id COLLATE utf8mb4_unicode_ci WHERE alc.lead_id = pl.id AND (alc.form_filled_at < TIMESTAMP '2026-10-08 00:00:00' OR afr.created_at < TIMESTAMP '2026-10-08 00:00:00' OR LEAST(afr.created_at, COALESCE(IF(afr.raw_payload->>'$.created_time' REGEXP '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{4}$', CONVERT_TZ(STR_TO_DATE(LEFT(afr.raw_payload->>'$.created_time', 19), '%Y-%m-%dT%H:%i:%s'), CONCAT(SUBSTRING(afr.raw_payload->>'$.created_time', 20, 3), ':', SUBSTRING(afr.raw_payload->>'$.created_time', 23, 2)), '+05:30'), NULL), afr.created_at)) < TIMESTAMP '2026-10-08 00:00:00')))), NOT EXISTS (SELECT 1 FROM meta_lead_raw afx WHERE afx.parsed_phone = r.parsed_phone AND (afx.created_at < TIMESTAMP '2026-10-08 00:00:00' OR LEAST(afx.created_at, COALESCE(IF(afx.raw_payload->>'$.created_time' REGEXP '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{4}$', CONVERT_TZ(STR_TO_DATE(LEFT(afx.raw_payload->>'$.created_time', 19), '%Y-%m-%dT%H:%i:%s'), CONCAT(SUBSTRING(afx.raw_payload->>'$.created_time', 20, 3), ':', SUBSTRING(afx.raw_payload->>'$.created_time', 23, 2)), '+05:30'), NULL), afx.created_at)) < TIMESTAMP '2026-10-08 00:00:00'))), 'meta_live', 'meta_old'), 'meta_live', 'meta_old', 'he') AS ft, mc.id AS campaign_id, mc.campaign_name FROM meta_lead_raw r FORCE INDEX (idx_ml_created) STRAIGHT_JOIN meta_campaign mc ON mc.id = r.campaign_id COLLATE utf8mb4_unicode_ci WHERE mc.requisition_id IN (?) AND (r.requisition_id IS NULL OR r.requisition_id = mc.requisition_id) AND r.parsed_phone IS NOT NULL AND r.created_at >= ? AND r.created_at < ?) f WHERE f.person IS NOT NULL AND f.person <> '' GROUP BY pkey, f.requisition_id UNION ALL SELECT 'l', MD5(al.mobile10 COLLATE utf8mb4_unicode_ci), d.requisition_id COLLATE utf8mb4_unicode_ci, NULL, m.lead_id AS tl, (COALESCE(rs.source_type, 'he') <> 'he' OR (d.source_kind IN ('meta','campaign') OR (d.source_kind = 'batch' AND EXISTS (SELECT 1 FROM he_import_batch hib WHERE hib.source = 'meta' AND JSON_CONTAINS(d.source_ids, JSON_QUOTE(hib.id)))))) AS tm, (d.drive_date >= TIMESTAMP '2026-10-08 00:00:00') AS tr, rs.id, rs.origin_id, COALESCE(rs.origin_label, ''), d.id, COALESCE(d.run_label, CONCAT('Re-run ', DATE_FORMAT(d.drive_date, '%Y-%m-%d'))) FROM he_drive d JOIN he_match m ON m.drive_id = d.id AND m.requisition_id = d.requisition_id LEFT JOIN requisition_stream_match sm ON sm.match_id = m.id LEFT JOIN requisition_stream rs ON rs.id = sm.stream_id AND rs.requisition_id = d.requisition_id JOIN he_lead al ON al.id = m.lead_id WHERE d.requisition_id IN (?) AND d.drive_date BETWEEN ? AND ? AND al.mobile10 IS NOT NULL AND al.mobile10 <> ''",
    [
      "r1",
      "2026-10-01 00:00:00",
      "2026-10-15 00:00:00",
      "r1",
      "2026-10-01",
      "2026-10-14",
