      "2026-10-14",
    ],
  ],
  [
    "SELECT /*+ MAX_EXECUTION_TIME(8000) */ STRAIGHT_JOIN m.lead_id AS tl, (COALESCE(rs.source_type, 'he') <> 'he' OR (d.source_kind IN ('meta','campaign') OR (d.source_kind = 'batch' AND EXISTS (SELECT 1 FROM he_import_batch hib WHERE hib.source = 'meta' AND JSON_CONTAINS(d.source_ids, JSON_QUOTE(hib.id)))))) AS tm, (d.drive_date >= TIMESTAMP '2026-10-08 00:00:00') AS tr, (m.distance_km > ?) AS far, COUNT(DISTINCT m.id) AS n, COUNT(DISTINCT CASE WHEN m.state IN ('arrived','selected') THEN m.id END) AS hits FROM he_drive d JOIN he_match m ON m.drive_id = d.id AND m.requisition_id = d.requisition_id LEFT JOIN requisition_stream_match sm ON sm.match_id = m.id LEFT JOIN requisition_stream rs ON rs.id = sm.stream_id AND rs.requisition_id = d.requisition_id WHERE d.requisition_id IN (?) AND d.drive_date BETWEEN ? AND ? AND m.distance_km IS NOT NULL AND m.state IN ('confirmed','arrived','no_show','selected') GROUP BY tl, tm, tr, far",
    [
      15,
      "r1",
