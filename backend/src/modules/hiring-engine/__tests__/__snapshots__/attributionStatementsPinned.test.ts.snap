exports[`source-typed statements (pinned) > insight facts 1`] = `
[
  [
    "SELECT param_key FROM he_model_param WHERE param_key LIKE ? AND value = 1",
    [
      "meta.live_from.%",
    ],
  ],
  [
    "SELECT STRAIGHT_JOIN CASE WHEN COALESCE(rs.source_type, 'he') <> 'he' OR (d.source_kind IN ('meta','campaign') OR (d.source_kind = 'batch' AND EXISTS (SELECT 1 FROM he_import_batch hib WHERE hib.source = 'meta' AND JSON_CONTAINS(d.source_ids, JSON_QUOTE(hib.id))))) OR (al.meta_lead_id IS NOT NULL OR EXISTS (SELECT 1 FROM he_lead_campaign alx WHERE alx.lead_id = al.id)) THEN IF(d.drive_date >= TIMESTAMP '2026-10-08 00:00:00' AND ((alf.id IS NULL OR (alf.created_at >= TIMESTAMP '2026-10-08 00:00:00' AND LEAST(alf.created_at, COALESCE(IF(alf.raw_payload->>'$.created_time' REGEXP '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{4}$', CONVERT_TZ(STR_TO_DATE(LEFT(alf.raw_payload->>'$.created_time', 19), '%Y-%m-%dT%H:%i:%s'), CONCAT(SUBSTRING(alf.raw_payload->>'$.created_time', 20, 3), ':', SUBSTRING(alf.raw_payload->>'$.created_time', 23, 2)), '+05:30'), NULL), alf.created_at)) >= TIMESTAMP '2026-10-08 00:00:00')) AND (alf.id IS NOT NULL OR EXISTS (SELECT 1 FROM he_lead_campaign aly WHERE aly.lead_id = al.id)) AND NOT EXISTS (SELECT 1 FROM he_lead_campaign alc JOIN meta_lead_raw afr ON afr.id = alc.meta_lead_id COLLATE utf8mb4_unicode_ci WHERE alc.lead_id = al.id AND (alc.form_filled_at < TIMESTAMP '2026-10-08 00:00:00' OR afr.created_at < TIMESTAMP '2026-10-08 00:00:00' OR LEAST(afr.created_at, COALESCE(IF(afr.raw_payload->>'$.created_time' REGEXP '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{4}$', CONVERT_TZ(STR_TO_DATE(LEFT(afr.raw_payload->>'$.created_time', 19), '%Y-%m-%dT%H:%i:%s'), CONCAT(SUBSTRING(afr.raw_payload->>'$.created_time', 20, 3), ':', SUBSTRING(afr.raw_payload->>'$.created_time', 23, 2)), '+05:30'), NULL), afr.created_at)) < TIMESTAMP '2026-10-08 00:00:00'))), 'meta_live', 'meta_old') ELSE 'he' END AS source_type, (LEAST(ABS(HOUR(o.created_at) - CAST(li.best_hour_ist AS SIGNED)), 24 - ABS(HOUR(o.created_at) - CAST(li.best_hour_ist AS SIGNED))) > ?) AS outside, COUNT(DISTINCT o.id) AS n, COUNT(DISTINCT CASE WHEN EXISTS (SELECT 1 FROM he_message i WHERE i.lead_id = m.lead_id AND i.direction = 'in' AND i.created_at > o.created_at AND i.created_at <= DATE_ADD(o.created_at, INTERVAL 24 HOUR)) THEN o.id END) AS hits FROM he_drive d JOIN he_match m ON m.drive_id = d.id AND m.requisition_id = d.requisition_id LEFT JOIN requisition_stream_match sm ON sm.match_id = m.id LEFT JOIN requisition_stream rs ON rs.id = sm.stream_id AND rs.requisition_id = d.requisition_id LEFT JOIN he_lead al ON al.id = m.lead_id LEFT JOIN meta_lead_raw alf ON alf.id = al.meta_lead_id COLLATE utf8mb4_unicode_ci JOIN he_message o ON o.lead_id = m.lead_id AND o.direction = 'out' AND o.channel IN ('email','whatsapp') AND o.template_key LIKE 'he_walkin_invite%' AND o.created_at >= ? AND o.created_at < ? JOIN he_lead_insight li ON li.lead_id = m.lead_id AND li.best_hour_ist IS NOT NULL WHERE d.requisition_id IN (?) AND d.drive_date BETWEEN ? AND ? GROUP BY 1, 2",
    [
      1,
      "2026-10-01 00:00:00",
      "2026-10-15 00:00:00",
      "r1",
      "2026-10-01",
      "2026-10-14",
    ],
