ited, SUM(m.state IN ('confirmed','arrived','selected')) AS confirmed, SUM(m.state IN ('arrived','selected')) AS arrived, SUM(m.state = 'no_show') AS no_show, SUM(m.state = 'declined') AS declined, SUM((m.state IN ('arrived','selected') AND m.slot_at IS NULL)) AS unplanned FROM he_drive d LEFT JOIN he_match m ON m.drive_id = d.id AND m.requisition_id = d.requisition_id LEFT JOIN requisition_stream_match sm ON sm.match_id = m.id LEFT JOIN requisition_stream s ON s.id = sm.stream_id AND s.requisition_id = d.requisition_id LEFT JOIN he_lead al ON al.id = m.lead_id LEFT JOIN meta_lead_raw alf ON alf.id = al.meta_lead_id COLLATE utf8mb4_unicode_ci WHERE d.requisition_id = ? AND d.branch_name = ? AND d.drive_date BETWEEN ? AND ? GROUP BY d.id, s.id, 6 ORDER BY d.drive_date, d.id",
