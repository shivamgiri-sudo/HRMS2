    ],
  ],
  [
    "SELECT /*+ MAX_EXECUTION_TIME(8000) */ param_key, value FROM he_model_param WHERE param_key LIKE 'cost.%'",
    undefined,
  ],
  [
    "SELECT /*+ MAX_EXECUTION_TIME(8000) */ id, spend_inr, last_synced_at FROM meta_campaign WHERE requisition_id IN (?) AND spend_inr > 0",
    [
      "r1",
    ],
  ],
  [
    "SELECT /*+ MAX_EXECUTION_TIME(8000) */ h.lead_id AS tl, (COALESCE(rs.source_type, 'he') <> 'he' OR (d.source_kind IN ('meta','campaign') OR (d.source_kind = 'batch' AND EXISTS (SELECT 1 FROM he_import_batch hib WHERE hib.source = 'meta' AND JSON_CONTAINS(d.source_ids, JSON_QUOTE(hib.id)))))) AS tm, (h.created_at >= TIMESTAMP '2026-10-08 00:00:00') AS tr, h.channel, MD5(h.mobile10) AS mk, DATE(h.created_at) AS dy, COUNT(DISTINCT h.id) AS msgs FROM he_message h LEFT JOIN he_drive d ON d.id = h.drive_id LEFT JOIN he_match m ON m.lead_id = h.lead_id AND m.requisition_id = h.requisition_id LEFT JOIN requisition_stream_match sm ON sm.match_id = m.id LEFT JOIN requisition_stream rs ON rs.id = sm.stream_id AND rs.requisition_id = h.requisition_id WHERE h.requisition_id IN (?) AND h.created_at >= ? AND h.created_at < ? AND h.direction = 'out' AND h.channel IN ('whatsapp','email') AND h.delivery_status <> 'failed' GROUP BY tl, tm, tr, h.channel, mk, dy",
    [
      "r1",
      "2026-10-01 00:00:00",
      "2026-10-15 00:00:00",
    ],
  ],
  [
    "SELECT /*+ MAX_EXECUTION_TIME(8000) */ COALESCE(c.lead_id, m.lead_id) AS tl, (COALESCE(rs.source_type, 'he') <> 'he' OR (d.source_kind IN ('meta','campaign') OR (d.source_kind = 'batch' AND EXISTS (SELECT 1 FROM he_import_batch hib WHERE hib.source = 'meta' AND JSON_CONTAINS(d.source_ids, JSON_QUOTE(hib.id)))))) AS tm, (c.created_at >= TIMESTAMP '2026-10-08 00:00:00') AS tr, COUNT(*) AS calls, SUM(CEIL(COALESCE(c.duration_s, 0) / 60)) AS minutes FROM he_call c LEFT JOIN he_match m ON m.id = c.match_id LEFT JOIN he_drive d ON d.id = COALESCE(c.drive_id, m.drive_id) LEFT JOIN requisition_stream_match sm ON sm.match_id = m.id LEFT JOIN requisition_stream rs ON rs.id = sm.stream_id AND rs.requisition_id = c.requisition_id WHERE c.requisition_id IN (?) AND c.created_at >= ? AND c.created_at < ? GROUP BY tl, tm, tr",
    [
      "r1",
      "2026-10-01 00:00:00",
      "2026-10-15 00:00:00",
    ],
  ],
]
`;

