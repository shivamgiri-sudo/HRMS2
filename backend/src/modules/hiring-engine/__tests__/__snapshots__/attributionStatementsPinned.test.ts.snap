    "SELECT f.requisition_id, f.source_type, f.origin_id, MAX(f.origin_label) AS origin_label, COUNT(*) AS qualified, SUM(f.emailed) AS emailed, SUM(f.whatsapped) AS whatsapped, SUM(f.replied) AS replied, SUM(f.called) AS called, SUM(f.confirmed) AS confirmed, SUM(f.arrived) AS arrived, SUM(f.selected) AS selected, SUM(f.joined) AS joined FROM ( SELECT qf.requisition_id, CASE WHEN (qd.source_kind IN ('meta','campaign') OR (qd.source_kind = 'batch' AND EXISTS (SELECT 1 FROM he_import_batch hib WHERE hib.source = 'meta' AND JSON_CONTAINS(qd.source_ids, JSON_QUOTE(hib.id))))) OR (hl.meta_lead_id IS NOT NULL OR EXISTS (SELECT 1 FROM he_lead_campaign alx WHERE alx.lead_id = hl.id) OR qf.meta_lead_id IS NOT NULL) THEN IF(qf.qualified_at >= TIMESTAMP '2026-10-08 00:00:00' AND ((hlf.id IS NULL OR (hlf.created_at >= TIMESTAMP '2026-10-08 00:00:00' AND LEAST(hlf.created_at, COALESCE(IF(hlf.raw_payload->>'$.created_time' REGEXP '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{4}$', CONVERT_TZ(STR_TO_DATE(LEFT(hlf.raw_payload->>'$.created_time', 19), '%Y-%m-%dT%H:%i:%s'), CONCAT(SUBSTRING(hlf.raw_payload->>'$.created_time', 20, 3), ':', SUBSTRING(hlf.raw_payload->>'$.created_time', 23, 2)), '+05:30'), NULL), hlf.created_at)) >= TIMESTAMP '2026-10-08 00:00:00')) AND (hlf.id IS NOT NULL OR EXISTS (SELECT 1 FROM he_lead_campaign aly WHERE aly.lead_id = hl.id)) AND NOT EXISTS (SELECT 1 FROM he_lead_campaign alc JOIN meta_lead_raw afr ON afr.id = alc.meta_lead_id COLLATE utf8mb4_unicode_ci WHERE alc.lead_id = hl.id AND (alc.form_filled_at < TIMESTAMP '2026-10-08 00:00:00' OR afr.created_at < TIMESTAMP '2026-10-08 00:00:00' OR LEAST(afr.created_at, COALESCE(IF(afr.raw_payload->>'$.created_time' REGEXP '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{4}$', CONVERT_TZ(STR_TO_DATE(LEFT(afr.raw_payload->>'$.created_time', 19), '%Y-%m-%dT%H:%i:%s'), CONCAT(SUBSTRING(afr.raw_payload->>'$.created_time', 20, 3), ':', SUBSTRING(afr.raw_payload->>'$.created_time', 23, 2)), '+05:30'), NULL), afr.created_at)) < TIMESTAMP '2026-10-08 00:00:00'))), 'meta_live', 'meta_old') ELSE 'he' END AS source_type, qf.origin_id, qf.origin_label, CASE WHEN qf.email_status = 'sent' OR EXISTS (SELECT 1 FROM he_message hm WHERE hm.requisition_id = qf.requisition_id AND hm.lead_id = qf.he_lead_id AND hm.channel = 'email' AND hm.direction = 'out' AND hm.delivery_status <> 'failed') THEN 1 ELSE 0 END AS emailed, CASE WHEN qf.wa_status = 'sent' OR EXISTS (SELECT 1 FROM he_message hm WHERE hm.requisition_id = qf.requisition_id AND hm.lead_id = qf.he_lead_id AND hm.channel = 'whatsapp' AND hm.direction = 'out' AND hm.delivery_status <> 'failed') THEN 1 ELSE 0 END AS whatsapped, CASE WHEN qf.stopped_reason = 'replied' OR EXISTS (SELECT 1 FROM he_message hi WHERE hi.lead_id = qf.he_lead_id AND hi.direction = 'in' AND hi.created_at > qf.qualified_at) OR EXISTS (SELECT 1 FROM meta_lead_messages mm WHERE mm.lead_id = qf.meta_lead_id COLLATE utf8mb4_unicode_ci AND mm.direction = 'inbound' AND mm.created_at > qf.qualified_at) THEN 1 ELSE 0 END AS replied, CASE WHEN qf.call_state = 'called' OR (m.id IS NOT NULL AND EXISTS (SELECT 1 FROM he_call c WHERE c.lead_id = m.lead_id AND c.match_id = m.id)) THEN 1 ELSE 0 END AS called, CASE WHEN m.state IN ('confirmed','arrived','selected') THEN 1 ELSE 0 END AS confirmed, CASE WHEN m.state IN ('arrived','selected') THEN 1 ELSE 0 END AS arrived, CASE WHEN (m.state IN ('arrived','selected') AND ((hl.status = 'joined' AND hl.status_at >= md.drive_date) OR (LOWER(ac.current_stage) IN ('joined','payroll_validated') AND (EXISTS (SELECT 1 FROM ats_candidate_stage_log sl WHERE sl.candidate_id = ac.id AND LOWER(sl.to_stage) IN ('joined','payroll_validated') AND sl.stage_date >= md.drive_date) OR EXISTS (SELECT 1 FROM ats_onboarding_bridge ob WHERE ob.candidate_id = ac.id AND ob.joining_date >= md.drive_date))))) THEN 1 ELSE 0 END AS joined, CASE WHEN ((m.state IN ('arrived','selected') AND ((hl.status = 'joined' AND hl.status_at >= md.drive_date) OR (LOWER(ac.current_stage) IN ('joined','payroll_validated') AND (EXISTS (SELECT 1 FROM ats_candidate_stage_log sl WHERE sl.candidate_id = ac.id AND LOWER(sl.to_stage) IN ('joined','payroll_validated') AND sl.stage_date >= md.drive_date) OR EXISTS (SELECT 1 FROM ats_onboarding_bridge ob WHERE ob.candidate_id = ac.id AND ob.joining_date >= md.drive_date))))) OR (m.state IN ('arrived','selected') AND ((m.state = 'selected' AND m.updated_at >= md.drive_date) OR (LOWER(ac.current_stage) IN ('selected','offered','offer','offer_approved','onboarded','converted') AND EXISTS (SELECT 1 FROM ats_candidate_stage_log sl WHERE sl.candidate_id = ac.id AND LOWER(sl.to_stage) IN ('selected','offered','offer','offer_approved','onboarded','converted','joined','payroll_validated') AND sl.stage_date >= md.drive_date))))) THEN 1 ELSE 0 END AS selected FROM qualified_followup qf LEFT JOIN he_match m ON m.lead_id = qf.he_lead_id AND m.requisition_id = qf.requisition_id LEFT JOIN he_drive md ON md.id = m.drive_id AND md.requisition_id = m.requisition_id LEFT JOIN he_lead hl ON hl.id = qf.he_lead_id LEFT JOIN ats_candidate ac ON ac.id = COALESCE(qf.ats_candidate_id, hl.ats_candidate_id) COLLATE utf8mb4_unicode_ci LEFT JOIN he_drive qd ON qd.id = COALESCE(qf.drive_id, m.drive_id) LEFT JOIN meta_lead_raw hlf ON hlf.id = COALESCE(hl.meta_lead_id, qf.meta_lead_id) COLLATE utf8mb4_unicode_ci WHERE qf.requisition_id IN (?) AND qf.qualified_at >= ? AND qf.qualified_at < ? ) f GROUP BY f.requisition_id, f.source_type, f.origin_id",
    [
      "r1",
      "2026-10-01 00:00:00",
      "2026-10-15 00:00:00",
    ],
  ],
  [
    "SELECT p.requisition_id, p.source_type, p.origin_kind, p.origin_id, MAX(p.origin_label) AS origin_label, COUNT(*) AS leads FROM ( SELECT u.person, u.requisition_id, SUBSTRING(MIN(CONCAT(FIELD(u.source_type, 'meta_live', 'meta_old', 'he'), u.source_type)), 2) AS source_type, SUBSTRING_INDEX(SUBSTRING_INDEX(MAX(u.okey), CHAR(31), 2), CHAR(31), -1) AS origin_kind, SUBSTRING_INDEX(SUBSTRING_INDEX(MAX(u.okey), CHAR(31), 3), CHAR(31), -1) AS origin_id, SUBSTRING_INDEX(MAX(u.okey), CHAR(31), -1) AS origin_label FROM ( SELECT f.person, f.requisition_id, f.source_type, CONCAT(4 - FIELD(f.source_type, 'meta_live', 'meta_old', 'he'), 3, CHAR(31), 'campaign', CHAR(31), f.campaign_id, CHAR(31), COALESCE(f.campaign_name, '')) COLLATE utf8mb4_unicode_ci AS okey FROM (SELECT RIGHT(REGEXP_REPLACE(r.parsed_phone, '[^0-9]', ''), 10) COLLATE utf8mb4_unicode_ci AS person, mc.requisition_id COLLATE utf8mb4_unicode_ci AS requisition_id, IF(r.created_at >= TIMESTAMP '2026-10-08 00:00:00' AND LEAST(r.created_at, COALESCE(IF(r.raw_payload->>'$.created_time' REGEXP '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{4}$', CONVERT_TZ(STR_TO_DATE(LEFT(r.raw_payload->>'$.created_time', 19), '%Y-%m-%dT%H:%i:%s'), CONCAT(SUBSTRING(r.raw_payload->>'$.created_time', 20, 3), ':', SUBSTRING(r.raw_payload->>'$.created_time', 23, 2)), '+05:30'), NULL), r.created_at)) >= TIMESTAMP '2026-10-08 00:00:00' AND IF(pl.id IS NOT NULL, ((plf.id IS NULL OR (plf.created_at >= TIMESTAMP '2026-10-08 00:00:00' AND LEAST(plf.created_at, COALESCE(IF(plf.raw_payload->>'$.created_time' REGEXP '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{4}$', CONVERT_TZ(STR_TO_DATE(LEFT(plf.raw_payload->>'$.created_time', 19), '%Y-%m-%dT%H:%i:%s'), CONCAT(SUBSTRING(plf.raw_payload->>'$.created_time', 20, 3), ':', SUBSTRING(plf.raw_payload->>'$.created_time', 23, 2)), '+05:30'), NULL), plf.created_at)) >= TIMESTAMP '2026-10-08 00:00:00')) AND (plf.id IS NOT NULL OR EXISTS (SELECT 1 FROM he_lead_campaign aly WHERE aly.lead_id = pl.id)) AND NOT EXISTS (SELECT 1 FROM he_lead_campaign alc JOIN meta_lead_raw afr ON afr.id = alc.meta_lead_id COLLATE utf8mb4_unicode_ci WHERE alc.lead_id = pl.id AND (alc.form_filled_at < TIMESTAMP '2026-10-08 00:00:00' OR afr.created_at < TIMESTAMP '2026-10-08 00:00:00' OR LEAST(afr.created_at, COALESCE(IF(afr.raw_payload->>'$.created_time' REGEXP '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{4}$', CONVERT_TZ(STR_TO_DATE(LEFT(afr.raw_payload->>'$.created_time', 19), '%Y-%m-%dT%H:%i:%s'), CONCAT(SUBSTRING(afr.raw_payload->>'$.created_time', 20, 3), ':', SUBSTRING(afr.raw_payload->>'$.created_time', 23, 2)), '+05:30'), NULL), afr.created_at)) < TIMESTAMP '2026-10-08 00:00:00'))), NOT EXISTS (SELECT 1 FROM meta_lead_raw afx WHERE afx.parsed_phone = r.parsed_phone AND (afx.created_at < TIMESTAMP '2026-10-08 00:00:00' OR LEAST(afx.created_at, COALESCE(IF(afx.raw_payload->>'$.created_time' REGEXP '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{4}$', CONVERT_TZ(STR_TO_DATE(LEFT(afx.raw_payload->>'$.created_time', 19), '%Y-%m-%dT%H:%i:%s'), CONCAT(SUBSTRING(afx.raw_payload->>'$.created_time', 20, 3), ':', SUBSTRING(afx.raw_payload->>'$.created_time', 23, 2)), '+05:30'), NULL), afx.created_at)) < TIMESTAMP '2026-10-08 00:00:00'))), 'meta_live', 'meta_old') AS source_type, mc.id AS campaign_id, mc.campaign_name FROM meta_campaign mc JOIN meta_lead_raw r ON r.campaign_id = mc.id COLLATE utf8mb4_unicode_ci LEFT JOIN he_lead pl ON pl.mobile10 = RIGHT(REGEXP_REPLACE(r.parsed_phone, '[^0-9]', ''), 10) COLLATE utf8mb4_unicode_ci LEFT JOIN meta_lead_raw plf ON plf.id = pl.meta_lead_id COLLATE utf8mb4_unicode_ci WHERE mc.requisition_id IN (?) AND (r.requisition_id IS NULL OR r.requisition_id = mc.requisition_id) AND r.parsed_phone IS NOT NULL AND r.created_at >= ? AND r.created_at < ?) f UNION ALL SELECT y.person, y.requisition_id, y.source_type, CONCAT(4 - FIELD(y.source_type, 'meta_live', 'meta_old', 'he'), IF(y.sid IS NOT NULL, 4, IF(y.source_type = 'he', 1, 2)), CHAR(31), IF(y.sid IS NOT NULL, 'stream', IF(y.source_type = 'he', 'pool', 'drive')), CHAR(31), IF(y.sid IS NOT NULL, y.stream_origin_id, IF(y.source_type = 'he', 'pool', y.drive_id)), CHAR(31), IF(y.sid IS NOT NULL, COALESCE(y.stream_origin_label, ''), IF(y.source_type = 'he', 'Pool: ATS history', COALESCE(y.run_label, CONCAT('Re-run ', DATE_FORMAT(y.drive_date, '%Y-%m-%d')))))) COLLATE utf8mb4_unicode_ci FROM (SELECT al.mobile10 COLLATE utf8mb4_unicode_ci AS person, d.requisition_id COLLATE utf8mb4_unicode_ci AS requisition_id, d.id AS drive_id, d.run_label, d.drive_date, rs.id AS sid, rs.origin_id AS stream_origin_id, rs.origin_label AS stream_origin_label, CASE WHEN COALESCE(rs.source_type, 'he') <> 'he' OR (d.source_kind IN ('meta','campaign') OR (d.source_kind = 'batch' AND EXISTS (SELECT 1 FROM he_import_batch hib WHERE hib.source = 'meta' AND JSON_CONTAINS(d.source_ids, JSON_QUOTE(hib.id))))) OR (al.meta_lead_id IS NOT NULL OR EXISTS (SELECT 1 FROM he_lead_campaign alx WHERE alx.lead_id = al.id)) THEN IF(d.drive_date >= TIMESTAMP '2026-10-08 00:00:00' AND ((alf.id IS NULL OR (alf.created_at >= TIMESTAMP '2026-10-08 00:00:00' AND LEAST(alf.created_at, COALESCE(IF(alf.raw_payload->>'$.created_time' REGEXP '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{4}$', CONVERT_TZ(STR_TO_DATE(LEFT(alf.raw_payload->>'$.created_time', 19), '%Y-%m-%dT%H:%i:%s'), CONCAT(SUBSTRING(alf.raw_payload->>'$.created_time', 20, 3), ':', SUBSTRING(alf.raw_payload->>'$.created_time', 23, 2)), '+05:30'), NULL), alf.created_at)) >= TIMESTAMP '2026-10-08 00:00:00')) AND (alf.id IS NOT NULL OR EXISTS (SELECT 1 FROM he_lead_campaign aly WHERE aly.lead_id = al.id)) AND NOT EXISTS (SELECT 1 FROM he_lead_campaign alc JOIN meta_lead_raw afr ON afr.id = alc.meta_lead_id COLLATE utf8mb4_unicode_ci WHERE alc.lead_id = al.id AND (alc.form_filled_at < TIMESTAMP '2026-10-08 00:00:00' OR afr.created_at < TIMESTAMP '2026-10-08 00:00:00' OR LEAST(afr.created_at, COALESCE(IF(afr.raw_payload->>'$.created_time' REGEXP '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{4}$', CONVERT_TZ(STR_TO_DATE(LEFT(afr.raw_payload->>'$.created_time', 19), '%Y-%m-%dT%H:%i:%s'), CONCAT(SUBSTRING(afr.raw_payload->>'$.created_time', 20, 3), ':', SUBSTRING(afr.raw_payload->>'$.created_time', 23, 2)), '+05:30'), NULL), afr.created_at)) < TIMESTAMP '2026-10-08 00:00:00'))), 'meta_live', 'meta_old') ELSE 'he' END AS source_type FROM he_drive d JOIN he_match m ON m.drive_id = d.id AND m.requisition_id = d.requisition_id LEFT JOIN requisition_stream_match sm ON sm.match_id = m.id LEFT JOIN requisition_stream rs ON rs.id = sm.stream_id AND rs.requisition_id = d.requisition_id LEFT JOIN he_lead al ON al.id = m.lead_id LEFT JOIN meta_lead_raw alf ON alf.id = al.meta_lead_id COLLATE utf8mb4_unicode_ci WHERE d.requisition_id IN (?) AND d.drive_date BETWEEN ? AND ?) y ) u WHERE u.person IS NOT NULL AND u.person <> '' GROUP BY u.person, u.requisition_id ) p GROUP BY p.requisition_id, p.source_type, p.origin_kind, p.origin_id",
    [
      "r1",
      "2026-10-01 00:00:00",
      "2026-10-15 00:00:00",
      "r1",
      "2026-10-01",
      "2026-10-14",
    ],
  ],
  [
    "SELECT id, requisition_id, campaign_name FROM meta_campaign WHERE requisition_id IN (?)",
    [
      "r1",
