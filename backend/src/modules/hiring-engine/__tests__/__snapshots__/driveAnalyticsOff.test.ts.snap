exports[`drive analytics with the plan 5 switches off > matches the recorded output and statement list > statements 1`] = `
[
  "SELECT /*+ MAX_EXECUTION_TIME(8000) */ STRAIGHT_JOIN (d.drive_date >= ?) AS cur, m.lead_id AS tl, (COALESCE(rs.source_type, 'he') <> 'he' OR (d.source_kind IN ('meta','campaign') OR (d.source_kind = 'batch' AND EXISTS (SELECT 1 FROM he_import_batch hib WHERE hib.source = 'meta' AND JSON_CONTAINS(d.source_ids, JSON_QUOTE(hib.id)))))) AS tm, (d.drive_date >= TIMESTAMP '2026-10-08 00:00:00') AS tr, COUNT(DISTINCT CASE WHEN ((m.state IN ('arrived','selected') AND ((hl.status = 'joined' AND hl.status_at >= d.drive_date) OR (LOWER(ac.current_stage) IN ('joined','payroll_validated') AND (EXISTS (SELECT 1 FROM ats_candidate_stage_log sl WHERE sl.candidate_id = ac.id AND LOWER(sl.to_stage) IN ('joined','payroll_validated') AND sl.stage_date >= d.drive_date) OR EXISTS (SELECT 1 FROM ats_onboarding_bridge ob WHERE ob.candidate_id = ac.id AND ob.joining_date >= d.drive_date))))) OR (m.state IN ('arrived','selected') AND ((m.state = 'selected' AND m.updated_at >= d.drive_date) OR (LOWER(ac.current_stage) IN ('selected','offered','offer','offer_approved','onboarded','converted') AND EXISTS (SELECT 1 FROM ats_candidate_stage_log sl WHERE sl.candidate_id = ac.id AND LOWER(sl.to_stage) IN ('selected','offered','offer','offer_approved','onboarded','converted','joined','payroll_validated') AND sl.stage_date >= d.drive_date))))) THEN m.id END) AS selected, COUNT(DISTINCT CASE WHEN (m.state IN ('arrived','selected') AND ((hl.status = 'joined' AND hl.status_at >= d.drive_date) OR (LOWER(ac.current_stage) IN ('joined','payroll_validated') AND (EXISTS (SELECT 1 FROM ats_candidate_stage_log sl WHERE sl.candidate_id = ac.id AND LOWER(sl.to_stage) IN ('joined','payroll_validated') AND sl.stage_date >= d.drive_date) OR EXISTS (SELECT 1 FROM ats_onboarding_bridge ob WHERE ob.candidate_id = ac.id AND ob.joining_date >= d.drive_date))))) THEN m.id END) AS joined, COUNT(DISTINCT CASE WHEN m.state = 'slot_released' THEN m.id END) AS slot_released FROM he_drive d JOIN he_match m ON m.drive_id = d.id AND m.requisition_id = d.requisition_id LEFT JOIN requisition_stream_match sm ON sm.match_id = m.id LEFT JOIN requisition_stream rs ON rs.id = sm.stream_id AND rs.requisition_id = d.requisition_id LEFT JOIN he_lead hl ON hl.id = m.lead_id LEFT JOIN ats_candidate ac ON ac.id = hl.ats_candidate_id COLLATE utf8mb4_unicode_ci WHERE d.requisition_id IN (?) AND d.drive_date BETWEEN ? AND ? GROUP BY cur, tl, tm, tr",
  "SELECT /*+ MAX_EXECUTION_TIME(8000) */ STRAIGHT_JOIN m.lead_id AS tl, (COALESCE(rs.source_type, 'he') <> 'he' OR (d.source_kind IN ('meta','campaign') OR (d.source_kind = 'batch' AND EXISTS (SELECT 1 FROM he_import_batch hib WHERE hib.source = 'meta' AND JSON_CONTAINS(d.source_ids, JSON_QUOTE(hib.id)))))) AS tm, (d.drive_date >= TIMESTAMP '2026-10-08 00:00:00') AS tr, WEEKDAY(ev.created_at) AS wd, HOUR(ev.created_at) AS hr, COUNT(DISTINCT m.id) AS n FROM he_drive d JOIN he_match m ON m.drive_id = d.id AND m.requisition_id = d.requisition_id LEFT JOIN requisition_stream_match sm ON sm.match_id = m.id LEFT JOIN requisition_stream rs ON rs.id = sm.stream_id AND rs.requisition_id = d.requisition_id JOIN he_lead_event ev ON ev.drive_id = d.id AND ev.lead_id = m.lead_id AND ev.event_type = 'arrived' WHERE d.requisition_id IN (?) AND d.drive_date BETWEEN ? AND ? GROUP BY tl, tm, tr, wd, hr",
  "SELECT /*+ MAX_EXECUTION_TIME(8000) */ STRAIGHT_JOIN m.lead_id AS tl, (COALESCE(rs.source_type, 'he') <> 'he' OR (d.source_kind IN ('meta','campaign') OR (d.source_kind = 'batch' AND EXISTS (SELECT 1 FROM he_import_batch hib WHERE hib.source = 'meta' AND JSON_CONTAINS(d.source_ids, JSON_QUOTE(hib.id)))))) AS tm, (d.drive_date >= TIMESTAMP '2026-10-08 00:00:00') AS tr, hm.id AS hid, WEEKDAY(hm.created_at) AS wd, HOUR(hm.created_at) AS hr FROM he_drive d JOIN he_match m ON m.drive_id = d.id AND m.requisition_id = d.requisition_id LEFT JOIN requisition_stream_match sm ON sm.match_id = m.id LEFT JOIN requisition_stream rs ON rs.id = sm.stream_id AND rs.requisition_id = d.requisition_id JOIN he_message hm ON hm.lead_id = m.lead_id AND hm.direction = 'in' AND hm.created_at >= ? AND hm.created_at < ? WHERE d.requisition_id IN (?) AND d.drive_date BETWEEN ? AND ? GROUP BY tl, tm, tr, hm.id",
  "SELECT /*+ MAX_EXECUTION_TIME(8000) */ hl.id AS tl, ((qd.source_kind IN ('meta','campaign') OR (qd.source_kind = 'batch' AND EXISTS (SELECT 1 FROM he_import_batch hib WHERE hib.source = 'meta' AND JSON_CONTAINS(qd.source_ids, JSON_QUOTE(hib.id))))) OR qf.meta_lead_id IS NOT NULL) AS tm, (qf.qualified_at >= TIMESTAMP '2026-10-08 00:00:00') AS tr, IF(hl.meta_lead_id IS NULL, ((hlf.id IS NULL OR (hlf.created_at >= TIMESTAMP '2026-10-08 00:00:00' AND LEAST(hlf.created_at, COALESCE(IF(hlf.raw_payload->>'$.created_time' REGEXP '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{4}$', CONVERT_TZ(STR_TO_DATE(LEFT(hlf.raw_payload->>'$.created_time', 19), '%Y-%m-%dT%H:%i:%s'), CONCAT(SUBSTRING(hlf.raw_payload->>'$.created_time', 20, 3), ':', SUBSTRING(hlf.raw_payload->>'$.created_time', 23, 2)), '+05:30'), NULL), hlf.created_at)) >= TIMESTAMP '2026-10-08 00:00:00')) AND (hlf.id IS NOT NULL OR EXISTS (SELECT 1 FROM he_lead_campaign aly WHERE aly.lead_id = hl.id)) AND NOT EXISTS (SELECT 1 FROM he_lead_campaign alc JOIN meta_lead_raw afr ON afr.id = alc.meta_lead_id COLLATE utf8mb4_unicode_ci WHERE alc.lead_id = hl.id AND (alc.form_filled_at < TIMESTAMP '2026-10-08 00:00:00' OR afr.created_at < TIMESTAMP '2026-10-08 00:00:00' OR LEAST(afr.created_at, COALESCE(IF(afr.raw_payload->>'$.created_time' REGEXP '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{4}$', CONVERT_TZ(STR_TO_DATE(LEFT(afr.raw_payload->>'$.created_time', 19), '%Y-%m-%dT%H:%i:%s'), CONCAT(SUBSTRING(afr.raw_payload->>'$.created_time', 20, 3), ':', SUBSTRING(afr.raw_payload->>'$.created_time', 23, 2)), '+05:30'), NULL), afr.created_at)) < TIMESTAMP '2026-10-08 00:00:00'))), NULL) AS tx, qf.stopped_reason, COUNT(*) AS n FROM qualified_followup qf LEFT JOIN he_match m ON m.lead_id = qf.he_lead_id AND m.requisition_id = qf.requisition_id LEFT JOIN he_lead hl ON hl.id = qf.he_lead_id LEFT JOIN he_drive qd ON qd.id = COALESCE(qf.drive_id, m.drive_id) LEFT JOIN meta_lead_raw hlf ON hlf.id = COALESCE(hl.meta_lead_id, qf.meta_lead_id) COLLATE utf8mb4_unicode_ci WHERE qf.requisition_id IN (?) AND qf.qualified_at >= ? AND qf.qualified_at < ? AND qf.stopped_reason IN ('opted_out','requisition_closed','no_contact_details') GROUP BY tl, tm, tr, tx, qf.stopped_reason",
  "SELECT /*+ MAX_EXECUTION_TIME(8000) */ jr.id AS requisition_id, jr.requisition_code, jr.designation_name, d.branch_name, d.id, d.drive_date, d.status, d.target_shows, s.id AS stream_id, m.lead_id AS tl, (COALESCE(s.source_type, 'he') <> 'he' OR (d.source_kind IN ('meta','campaign') OR (d.source_kind = 'batch' AND EXISTS (SELECT 1 FROM he_import_batch hib WHERE hib.source = 'meta' AND JSON_CONTAINS(d.source_ids, JSON_QUOTE(hib.id)))))) AS tm, (d.drive_date >= TIMESTAMP '2026-10-08 00:00:00') AS tr, COUNT(m.id) AS lined, SUM(m.state IN ('invited','confirmed','slot_released','arrived','no_show','selected')) AS invited, SUM(m.state IN ('confirmed','arrived','selected')) AS confirmed, SUM(m.state IN ('arrived','selected')) AS arrived, SUM(m.state = 'no_show') AS no_show, SUM(m.state = 'declined') AS declined, SUM((m.state IN ('arrived','selected') AND m.slot_at IS NULL)) AS unplanned FROM job_requisition jr LEFT JOIN he_drive d ON d.requisition_id = jr.id COLLATE utf8mb4_unicode_ci AND d.drive_date BETWEEN ? AND ? LEFT JOIN he_match m ON m.drive_id = d.id AND m.requisition_id = d.requisition_id LEFT JOIN requisition_stream_match sm ON sm.match_id = m.id LEFT JOIN requisition_stream s ON s.id = sm.stream_id AND s.requisition_id = d.requisition_id WHERE jr.id IN (?) GROUP BY jr.id, d.id, s.id, tl, tm, tr",
  "SELECT /*+ MAX_EXECUTION_TIME(8000) */ jr.id, jr.requisition_code, jr.designation_name, jr.branch_name, MAX(x.last_drive) AS last_drive FROM ( SELECT d.requisition_id COLLATE utf8mb4_unicode_ci AS rid, MAX(d.drive_date) AS last_drive FROM he_drive d WHERE d.drive_date BETWEEN ? AND ? GROUP BY d.requisition_id UNION ALL SELECT mc.requisition_id COLLATE utf8mb4_unicode_ci, NULL FROM meta_campaign mc WHERE mc.campaign_status = 'active' AND mc.requisition_id IS NOT NULL ) x JOIN job_requisition jr ON jr.id = x.rid COLLATE utf8mb4_unicode_ci WHERE 1 = 1 GROUP BY jr.id, jr.requisition_code, jr.designation_name, jr.branch_name ORDER BY MAX(x.last_drive) IS NULL, MAX(x.last_drive) DESC, jr.id LIMIT 201",
  "SELECT /*+ MAX_EXECUTION_TIME(8000) */ p.cur, p.requisition_id, p.tl, p.frank, p.lead_rows, p.any_m, p.any_r, p.any_mr, p.campaign_id, p.stage, p.q, p.sel, p.joi FROM ( SELECT u.cur, u.person, u.requisition_id, MIN(u.ft) AS frank, MAX(u.tl) AS tl, MAX(u.ft IS NULL) AS lead_rows, MAX(u.ft IS NULL AND u.tm) AS any_m, MAX(u.ft IS NULL AND u.tr) AS any_r, MAX(u.ft IS NULL AND u.tm AND u.tr) AS any_mr, NULLIF(SUBSTRING(MAX(CONCAT(u.cpri, COALESCE(u.campaign_id, ''))), 2), '') AS campaign_id, MAX(u.stage) AS stage, MAX(u.q) AS q, MAX(u.sel) AS sel, MAX(u.joi) AS joi FROM ( SELECT (r.created_at >= ?) AS cur, RIGHT(REGEXP_REPLACE(r.parsed_phone, '[^0-9]', ''), 10) COLLATE utf8mb4_unicode_ci AS person, mc.requisition_id COLLATE utf8mb4_unicode_ci AS requisition_id, FIELD(IF(r.created_at >= TIMESTAMP '2026-10-08 00:00:00' AND LEAST(r.created_at, COALESCE(IF(r.raw_payload->>'$.created_time' REGEXP '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{4}$', CONVERT_TZ(STR_TO_DATE(LEFT(r.raw_payload->>'$.created_time', 19), '%Y-%m-%dT%H:%i:%s'), CONCAT(SUBSTRING(r.raw_payload->>'$.created_time', 20, 3), ':', SUBSTRING(r.raw_payload->>'$.created_time', 23, 2)), '+05:30'), NULL), r.created_at)) >= TIMESTAMP '2026-10-08 00:00:00' AND IF(EXISTS (SELECT 1 FROM he_lead pl WHERE pl.mobile10 = RIGHT(REGEXP_REPLACE(r.parsed_phone, '[^0-9]', ''), 10) COLLATE utf8mb4_unicode_ci), EXISTS (SELECT 1 FROM he_lead pl LEFT JOIN meta_lead_raw plf ON plf.id = pl.meta_lead_id COLLATE utf8mb4_unicode_ci WHERE pl.mobile10 = RIGHT(REGEXP_REPLACE(r.parsed_phone, '[^0-9]', ''), 10) COLLATE utf8mb4_unicode_ci AND ((plf.id IS NULL OR (plf.created_at >= TIMESTAMP '2026-10-08 00:00:00' AND LEAST(plf.created_at, COALESCE(IF(plf.raw_payload->>'$.created_time' REGEXP '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{4}$', CONVERT_TZ(STR_TO_DATE(LEFT(plf.raw_payload->>'$.created_time', 19), '%Y-%m-%dT%H:%i:%s'), CONCAT(SUBSTRING(plf.raw_payload->>'$.created_time', 20, 3), ':', SUBSTRING(plf.raw_payload->>'$.created_time', 23, 2)), '+05:30'), NULL), plf.created_at)) >= TIMESTAMP '2026-10-08 00:00:00')) AND (plf.id IS NOT NULL OR EXISTS (SELECT 1 FROM he_lead_campaign aly WHERE aly.lead_id = pl.id)) AND NOT EXISTS (SELECT 1 FROM he_lead_campaign alc JOIN meta_lead_raw afr ON afr.id = alc.meta_lead_id COLLATE utf8mb4_unicode_ci WHERE alc.lead_id = pl.id AND (alc.form_filled_at < TIMESTAMP '2026-10-08 00:00:00' OR afr.created_at < TIMESTAMP '2026-10-08 00:00:00' OR LEAST(afr.created_at, COALESCE(IF(afr.raw_payload->>'$.created_time' REGEXP '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{4}$', CONVERT_TZ(STR_TO_DATE(LEFT(afr.raw_payload->>'$.created_time', 19), '%Y-%m-%dT%H:%i:%s'), CONCAT(SUBSTRING(afr.raw_payload->>'$.created_time', 20, 3), ':', SUBSTRING(afr.raw_payload->>'$.created_time', 23, 2)), '+05:30'), NULL), afr.created_at)) < TIMESTAMP '2026-10-08 00:00:00')))), NOT EXISTS (SELECT 1 FROM meta_lead_raw afx WHERE afx.parsed_phone = r.parsed_phone AND (afx.created_at < TIMESTAMP '2026-10-08 00:00:00' OR LEAST(afx.created_at, COALESCE(IF(afx.raw_payload->>'$.created_time' REGEXP '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{4}$', CONVERT_TZ(STR_TO_DATE(LEFT(afx.raw_payload->>'$.created_time', 19), '%Y-%m-%dT%H:%i:%s'), CONCAT(SUBSTRING(afx.raw_payload->>'$.created_time', 20, 3), ':', SUBSTRING(afx.raw_payload->>'$.created_time', 23, 2)), '+05:30'), NULL), afx.created_at)) < TIMESTAMP '2026-10-08 00:00:00'))), 'meta_live', 'meta_old'), 'meta_live', 'meta_old', 'he') AS ft, NULL AS tl, 0 AS tm, 0 AS tr, IF(r.created_at >= ?, COALESCE((SELECT plf.campaign_id FROM he_lead pl JOIN meta_lead_raw plf ON plf.id = pl.meta_lead_id COLLATE utf8mb4_unicode_ci WHERE pl.mobile10 = RIGHT(REGEXP_REPLACE(r.parsed_phone, '[^0-9]', ''), 10) COLLATE utf8mb4_unicode_ci), r.campaign_id), NULL) COLLATE utf8mb4_unicode_ci AS campaign_id, 1 AS cpri, 0 AS stage, (r.screening_result = 'qualified') AS q, 0 AS sel, 0 AS joi FROM meta_lead_raw r FORCE INDEX (idx_ml_created) STRAIGHT_JOIN meta_campaign mc ON mc.id = r.campaign_id COLLATE utf8mb4_unicode_ci WHERE mc.requisition_id IN (?) AND (r.requisition_id IS NULL OR r.requisition_id = mc.requisition_id) AND r.parsed_phone IS NOT NULL AND r.created_at >= ? AND r.created_at < ? UNION ALL SELECT (d.drive_date >= ?), al.mobile10 COLLATE utf8mb4_unicode_ci, d.requisition_id COLLATE utf8mb4_unicode_ci, NULL, m.lead_id AS tl, (COALESCE(rs.source_type, 'he') <> 'he' OR (d.source_kind IN ('meta','campaign') OR (d.source_kind = 'batch' AND EXISTS (SELECT 1 FROM he_import_batch hib WHERE hib.source = 'meta' AND JSON_CONTAINS(d.source_ids, JSON_QUOTE(hib.id)))))) AS tm, (d.drive_date >= TIMESTAMP '2026-10-08 00:00:00') AS tr, alf.campaign_id COLLATE utf8mb4_unicode_ci, 1, CASE WHEN m.state IN ('arrived','selected') THEN 4 WHEN m.state = 'confirmed' THEN 3 WHEN m.state IN ('invited','slot_released','no_show') THEN 2 ELSE 0 END, 0, ((m.state IN ('arrived','selected') AND ((al.status = 'joined' AND al.status_at >= d.drive_date) OR (LOWER(ac.current_stage) IN ('joined','payroll_validated') AND (EXISTS (SELECT 1 FROM ats_candidate_stage_log sl WHERE sl.candidate_id = ac.id AND LOWER(sl.to_stage) IN ('joined','payroll_validated') AND sl.stage_date >= d.drive_date) OR EXISTS (SELECT 1 FROM ats_onboarding_bridge ob WHERE ob.candidate_id = ac.id AND ob.joining_date >= d.drive_date))))) OR (m.state IN ('arrived','selected') AND ((m.state = 'selected' AND m.updated_at >= d.drive_date) OR (LOWER(ac.current_stage) IN ('selected','offered','offer','offer_approved','onboarded','converted') AND EXISTS (SELECT 1 FROM ats_candidate_stage_log sl WHERE sl.candidate_id = ac.id AND LOWER(sl.to_stage) IN ('selected','offered','offer','offer_approved','onboarded','converted','joined','payroll_validated') AND sl.stage_date >= d.drive_date))))), (m.state IN ('arrived','selected') AND ((al.status = 'joined' AND al.status_at >= d.drive_date) OR (LOWER(ac.current_stage) IN ('joined','payroll_validated') AND (EXISTS (SELECT 1 FROM ats_candidate_stage_log sl WHERE sl.candidate_id = ac.id AND LOWER(sl.to_stage) IN ('joined','payroll_validated') AND sl.stage_date >= d.drive_date) OR EXISTS (SELECT 1 FROM ats_onboarding_bridge ob WHERE ob.candidate_id = ac.id AND ob.joining_date >= d.drive_date))))) FROM he_drive d JOIN he_match m ON m.drive_id = d.id AND m.requisition_id = d.requisition_id LEFT JOIN requisition_stream_match sm ON sm.match_id = m.id LEFT JOIN requisition_stream rs ON rs.id = sm.stream_id AND rs.requisition_id = d.requisition_id LEFT JOIN he_lead al ON al.id = m.lead_id LEFT JOIN meta_lead_raw alf ON alf.id = al.meta_lead_id COLLATE utf8mb4_unicode_ci LEFT JOIN ats_candidate ac ON ac.id = al.ats_candidate_id COLLATE utf8mb4_unicode_ci WHERE d.requisition_id IN (?) AND d.drive_date BETWEEN ? AND ? UNION ALL SELECT x.cur, x.mobile10 COLLATE utf8mb4_unicode_ci, x.requisition_id COLLATE utf8mb4_unicode_ci, NULL, x.lead_id AS tl, (COALESCE(rs.source_type, 'he') <> 'he' OR (d.source_kind IN ('meta','campaign') OR (d.source_kind = 'batch' AND EXISTS (SELECT 1 FROM he_import_batch hib WHERE hib.source = 'meta' AND JSON_CONTAINS(d.source_ids, JSON_QUOTE(hib.id)))))) AS tm, (x.last_at >= TIMESTAMP '2026-10-08 00:00:00') AS tr, alf.campaign_id COLLATE utf8mb4_unicode_ci, 1, x.stage, 0, 0, 0 FROM (SELECT (hm.created_at >= ?) AS cur, hm.mobile10, hm.requisition_id, hm.lead_id, hm.drive_id, MAX(IF(hm.template_key LIKE 'he_walkin_invite%', 2, 1)) AS stage, MAX(hm.created_at) AS last_at FROM he_message hm FORCE INDEX (idx_he_msg_req) WHERE hm.requisition_id IN (?) AND hm.created_at >= ? AND hm.created_at < ? AND hm.direction = 'out' AND (hm.delivery_status IS NULL OR hm.delivery_status <> 'failed') GROUP BY 1, hm.mobile10, hm.requisition_id, hm.lead_id, hm.drive_id) x LEFT JOIN he_drive d ON d.id = x.drive_id LEFT JOIN he_match m ON m.lead_id = x.lead_id AND m.requisition_id = x.requisition_id LEFT JOIN requisition_stream_match sm ON sm.match_id = m.id LEFT JOIN requisition_stream rs ON rs.id = sm.stream_id AND rs.requisition_id = x.requisition_id LEFT JOIN he_lead al ON al.id = x.lead_id LEFT JOIN meta_lead_raw alf ON alf.id = al.meta_lead_id COLLATE utf8mb4_unicode_ci UNION ALL SELECT (ev.created_at >= ?), al.mobile10 COLLATE utf8mb4_unicode_ci, x.requisition_id COLLATE utf8mb4_unicode_ci, NULL, ev.lead_id AS tl, (COALESCE(rs.source_type, 'he') <> 'he' OR (d.source_kind IN ('meta','campaign') OR (d.source_kind = 'batch' AND EXISTS (SELECT 1 FROM he_import_batch hib WHERE hib.source = 'meta' AND JSON_CONTAINS(d.source_ids, JSON_QUOTE(hib.id)))))) AS tm, (ev.created_at >= TIMESTAMP '2026-10-08 00:00:00') AS tr, alf.campaign_id COLLATE utf8mb4_unicode_ci, 1, 3, 0, 0, 0 FROM he_lead_event ev JOIN he_message x ON x.id = (SELECT h.id FROM he_message h WHERE h.lead_id = ev.lead_id AND h.direction = 'out' AND h.requisition_id IS NOT NULL AND (h.delivery_status IS NULL OR h.delivery_status <> 'failed') AND h.created_at <= ev.created_at ORDER BY h.created_at DESC, h.id DESC LIMIT 1) LEFT JOIN he_drive d ON d.id = x.drive_id LEFT JOIN he_match m ON m.lead_id = ev.lead_id AND m.requisition_id = x.requisition_id LEFT JOIN requisition_stream_match sm ON sm.match_id = m.id LEFT JOIN requisition_stream rs ON rs.id = sm.stream_id AND rs.requisition_id = x.requisition_id LEFT JOIN he_lead al ON al.id = ev.lead_id LEFT JOIN meta_lead_raw alf ON alf.id = al.meta_lead_id COLLATE utf8mb4_unicode_ci WHERE ev.event_type IN ('confirmed','call_confirmed') AND ev.created_at >= ? AND ev.created_at < ? AND x.requisition_id IN (?) UNION ALL SELECT (d.drive_date >= ?), al.mobile10 COLLATE utf8mb4_unicode_ci, d.requisition_id COLLATE utf8mb4_unicode_ci, NULL, ev.lead_id AS tl, (COALESCE(rs.source_type, 'he') <> 'he' OR (d.source_kind IN ('meta','campaign') OR (d.source_kind = 'batch' AND EXISTS (SELECT 1 FROM he_import_batch hib WHERE hib.source = 'meta' AND JSON_CONTAINS(d.source_ids, JSON_QUOTE(hib.id)))))) AS tm, (d.drive_date >= TIMESTAMP '2026-10-08 00:00:00') AS tr, alf.campaign_id COLLATE utf8mb4_unicode_ci, 1, 4, 0, 0, 0 FROM he_drive d JOIN he_lead_event ev ON ev.drive_id = d.id AND ev.event_type = 'arrived' LEFT JOIN he_match m ON m.lead_id = ev.lead_id AND m.requisition_id = d.requisition_id LEFT JOIN requisition_stream_match sm ON sm.match_id = m.id LEFT JOIN requisition_stream rs ON rs.id = sm.stream_id AND rs.requisition_id = d.requisition_id LEFT JOIN he_lead al ON al.id = ev.lead_id LEFT JOIN meta_lead_raw alf ON alf.id = al.meta_lead_id COLLATE utf8mb4_unicode_ci WHERE d.requisition_id IN (?) AND d.drive_date BETWEEN ? AND ? ) u WHERE u.person IS NOT NULL AND u.person <> '' GROUP BY u.cur, u.person, u.requisition_id ) p",
  "SELECT /*+ MAX_EXECUTION_TIME(8000) */ p.cur, p.requisition_id, p.tl, p.frank, p.lead_rows, p.any_m, p.any_r, p.any_mr, p.campaign_id, p.stage, p.q, p.sel, p.joi FROM ( SELECT u.cur, u.person, u.requisition_id, MIN(u.ft) AS frank, MAX(u.tl) AS tl, MAX(u.ft IS NULL) AS lead_rows, MAX(u.ft IS NULL AND u.tm) AS any_m, MAX(u.ft IS NULL AND u.tr) AS any_r, MAX(u.ft IS NULL AND u.tm AND u.tr) AS any_mr, NULLIF(SUBSTRING(MAX(CONCAT(u.cpri, COALESCE(u.campaign_id, ''))), 2), '') AS campaign_id, MAX(u.stage) AS stage, MAX(u.q) AS q, MAX(u.sel) AS sel, MAX(u.joi) AS joi FROM ( SELECT (r.created_at >= ?) AS cur, RIGHT(REGEXP_REPLACE(r.parsed_phone, '[^0-9]', ''), 10) COLLATE utf8mb4_unicode_ci AS person, mc.requisition_id COLLATE utf8mb4_unicode_ci AS requisition_id, FIELD(IF(r.created_at >= TIMESTAMP '2026-10-08 00:00:00' AND LEAST(r.created_at, COALESCE(IF(r.raw_payload->>'$.created_time' REGEXP '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{4}$', CONVERT_TZ(STR_TO_DATE(LEFT(r.raw_payload->>'$.created_time', 19), '%Y-%m-%dT%H:%i:%s'), CONCAT(SUBSTRING(r.raw_payload->>'$.created_time', 20, 3), ':', SUBSTRING(r.raw_payload->>'$.created_time', 23, 2)), '+05:30'), NULL), r.created_at)) >= TIMESTAMP '2026-10-08 00:00:00' AND IF(EXISTS (SELECT 1 FROM he_lead pl WHERE pl.mobile10 = RIGHT(REGEXP_REPLACE(r.parsed_phone, '[^0-9]', ''), 10) COLLATE utf8mb4_unicode_ci), EXISTS (SELECT 1 FROM he_lead pl LEFT JOIN meta_lead_raw plf ON plf.id = pl.meta_lead_id COLLATE utf8mb4_unicode_ci WHERE pl.mobile10 = RIGHT(REGEXP_REPLACE(r.parsed_phone, '[^0-9]', ''), 10) COLLATE utf8mb4_unicode_ci AND ((plf.id IS NULL OR (plf.created_at >= TIMESTAMP '2026-10-08 00:00:00' AND LEAST(plf.created_at, COALESCE(IF(plf.raw_payload->>'$.created_time' REGEXP '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{4}$', CONVERT_TZ(STR_TO_DATE(LEFT(plf.raw_payload->>'$.created_time', 19), '%Y-%m-%dT%H:%i:%s'), CONCAT(SUBSTRING(plf.raw_payload->>'$.created_time', 20, 3), ':', SUBSTRING(plf.raw_payload->>'$.created_time', 23, 2)), '+05:30'), NULL), plf.created_at)) >= TIMESTAMP '2026-10-08 00:00:00')) AND (plf.id IS NOT NULL OR EXISTS (SELECT 1 FROM he_lead_campaign aly WHERE aly.lead_id = pl.id)) AND NOT EXISTS (SELECT 1 FROM he_lead_campaign alc JOIN meta_lead_raw afr ON afr.id = alc.meta_lead_id COLLATE utf8mb4_unicode_ci WHERE alc.lead_id = pl.id AND (alc.form_filled_at < TIMESTAMP '2026-10-08 00:00:00' OR afr.created_at < TIMESTAMP '2026-10-08 00:00:00' OR LEAST(afr.created_at, COALESCE(IF(afr.raw_payload->>'$.created_time' REGEXP '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{4}$', CONVERT_TZ(STR_TO_DATE(LEFT(afr.raw_payload->>'$.created_time', 19), '%Y-%m-%dT%H:%i:%s'), CONCAT(SUBSTRING(afr.raw_payload->>'$.created_time', 20, 3), ':', SUBSTRING(afr.raw_payload->>'$.created_time', 23, 2)), '+05:30'), NULL), afr.created_at)) < TIMESTAMP '2026-10-08 00:00:00')))), NOT EXISTS (SELECT 1 FROM meta_lead_raw afx WHERE afx.parsed_phone = r.parsed_phone AND (afx.created_at < TIMESTAMP '2026-10-08 00:00:00' OR LEAST(afx.created_at, COALESCE(IF(afx.raw_payload->>'$.created_time' REGEXP '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{4}$', CONVERT_TZ(STR_TO_DATE(LEFT(afx.raw_payload->>'$.created_time', 19), '%Y-%m-%dT%H:%i:%s'), CONCAT(SUBSTRING(afx.raw_payload->>'$.created_time', 20, 3), ':', SUBSTRING(afx.raw_payload->>'$.created_time', 23, 2)), '+05:30'), NULL), afx.created_at)) < TIMESTAMP '2026-10-08 00:00:00'))), 'meta_live', 'meta_old'), 'meta_live', 'meta_old', 'he') AS ft, NULL AS tl, 0 AS tm, 0 AS tr, IF(r.created_at >= ?, COALESCE((SELECT plf.campaign_id FROM he_lead pl JOIN meta_lead_raw plf ON plf.id = pl.meta_lead_id COLLATE utf8mb4_unicode_ci WHERE pl.mobile10 = RIGHT(REGEXP_REPLACE(r.parsed_phone, '[^0-9]', ''), 10) COLLATE utf8mb4_unicode_ci), r.campaign_id), NULL) COLLATE utf8mb4_unicode_ci AS campaign_id, 1 AS cpri, 0 AS stage, (r.screening_result = 'qualified') AS q, 0 AS sel, 0 AS joi FROM meta_lead_raw r FORCE INDEX (idx_ml_created) STRAIGHT_JOIN meta_campaign mc ON mc.id = r.campaign_id COLLATE utf8mb4_unicode_ci WHERE mc.requisition_id IN (?) AND (r.requisition_id IS NULL OR r.requisition_id = mc.requisition_id) AND r.parsed_phone IS NOT NULL AND r.created_at >= ? AND r.created_at < ? UNION ALL SELECT (d.drive_date >= ?), al.mobile10 COLLATE utf8mb4_unicode_ci, d.requisition_id COLLATE utf8mb4_unicode_ci, NULL, m.lead_id AS tl, (COALESCE(rs.source_type, 'he') <> 'he' OR (d.source_kind IN ('meta','campaign') OR (d.source_kind = 'batch' AND EXISTS (SELECT 1 FROM he_import_batch hib WHERE hib.source = 'meta' AND JSON_CONTAINS(d.source_ids, JSON_QUOTE(hib.id)))))) AS tm, (d.drive_date >= TIMESTAMP '2026-10-08 00:00:00') AS tr, alf.campaign_id COLLATE utf8mb4_unicode_ci, 1, CASE WHEN m.state IN ('arrived','selected') THEN 4 WHEN m.state = 'confirmed' THEN 3 WHEN m.state IN ('invited','slot_released','no_show') THEN 2 ELSE 0 END, 0, ((m.state IN ('arrived','selected') AND ((al.status = 'joined' AND al.status_at >= d.drive_date) OR (LOWER(ac.current_stage) IN ('joined','payroll_validated') AND (EXISTS (SELECT 1 FROM ats_candidate_stage_log sl WHERE sl.candidate_id = ac.id AND LOWER(sl.to_stage) IN ('joined','payroll_validated') AND sl.stage_date >= d.drive_date) OR EXISTS (SELECT 1 FROM ats_onboarding_bridge ob WHERE ob.candidate_id = ac.id AND ob.joining_date >= d.drive_date))))) OR (m.state IN ('arrived','selected') AND ((m.state = 'selected' AND m.updated_at >= d.drive_date) OR (LOWER(ac.current_stage) IN ('selected','offered','offer','offer_approved','onboarded','converted') AND EXISTS (SELECT 1 FROM ats_candidate_stage_log sl WHERE sl.candidate_id = ac.id AND LOWER(sl.to_stage) IN ('selected','offered','offer','offer_approved','onboarded','converted','joined','payroll_validated') AND sl.stage_date >= d.drive_date))))), (m.state IN ('arrived','selected') AND ((al.status = 'joined' AND al.status_at >= d.drive_date) OR (LOWER(ac.current_stage) IN ('joined','payroll_validated') AND (EXISTS (SELECT 1 FROM ats_candidate_stage_log sl WHERE sl.candidate_id = ac.id AND LOWER(sl.to_stage) IN ('joined','payroll_validated') AND sl.stage_date >= d.drive_date) OR EXISTS (SELECT 1 FROM ats_onboarding_bridge ob WHERE ob.candidate_id = ac.id AND ob.joining_date >= d.drive_date))))) FROM he_drive d JOIN he_match m ON m.drive_id = d.id AND m.requisition_id = d.requisition_id LEFT JOIN requisition_stream_match sm ON sm.match_id = m.id LEFT JOIN requisition_stream rs ON rs.id = sm.stream_id AND rs.requisition_id = d.requisition_id LEFT JOIN he_lead al ON al.id = m.lead_id LEFT JOIN meta_lead_raw alf ON alf.id = al.meta_lead_id COLLATE utf8mb4_unicode_ci LEFT JOIN ats_candidate ac ON ac.id = al.ats_candidate_id COLLATE utf8mb4_unicode_ci WHERE d.requisition_id IN (?) AND d.drive_date BETWEEN ? AND ? UNION ALL SELECT x.cur, x.mobile10 COLLATE utf8mb4_unicode_ci, x.requisition_id COLLATE utf8mb4_unicode_ci, NULL, x.lead_id AS tl, (COALESCE(rs.source_type, 'he') <> 'he' OR (d.source_kind IN ('meta','campaign') OR (d.source_kind = 'batch' AND EXISTS (SELECT 1 FROM he_import_batch hib WHERE hib.source = 'meta' AND JSON_CONTAINS(d.source_ids, JSON_QUOTE(hib.id)))))) AS tm, (x.last_at >= TIMESTAMP '2026-10-08 00:00:00') AS tr, alf.campaign_id COLLATE utf8mb4_unicode_ci, 1, x.stage, 0, 0, 0 FROM (SELECT (hm.created_at >= ?) AS cur, hm.mobile10, hm.requisition_id, hm.lead_id, hm.drive_id, MAX(IF(hm.template_key LIKE 'he_walkin_invite%', 2, 1)) AS stage, MAX(hm.created_at) AS last_at FROM he_message hm FORCE INDEX (idx_he_msg_req) WHERE hm.requisition_id IN (?) AND hm.created_at >= ? AND hm.created_at < ? AND hm.direction = 'out' AND (hm.delivery_status IS NULL OR hm.delivery_status <> 'failed') GROUP BY 1, hm.mobile10, hm.requisition_id, hm.lead_id, hm.drive_id) x LEFT JOIN he_drive d ON d.id = x.drive_id LEFT JOIN he_match m ON m.lead_id = x.lead_id AND m.requisition_id = x.requisition_id LEFT JOIN requisition_stream_match sm ON sm.match_id = m.id LEFT JOIN requisition_stream rs ON rs.id = sm.stream_id AND rs.requisition_id = x.requisition_id LEFT JOIN he_lead al ON al.id = x.lead_id LEFT JOIN meta_lead_raw alf ON alf.id = al.meta_lead_id COLLATE utf8mb4_unicode_ci UNION ALL SELECT (ev.created_at >= ?), al.mobile10 COLLATE utf8mb4_unicode_ci, x.requisition_id COLLATE utf8mb4_unicode_ci, NULL, ev.lead_id AS tl, (COALESCE(rs.source_type, 'he') <> 'he' OR (d.source_kind IN ('meta','campaign') OR (d.source_kind = 'batch' AND EXISTS (SELECT 1 FROM he_import_batch hib WHERE hib.source = 'meta' AND JSON_CONTAINS(d.source_ids, JSON_QUOTE(hib.id)))))) AS tm, (ev.created_at >= TIMESTAMP '2026-10-08 00:00:00') AS tr, alf.campaign_id COLLATE utf8mb4_unicode_ci, 1, 3, 0, 0, 0 FROM he_lead_event ev JOIN he_message x ON x.id = (SELECT h.id FROM he_message h WHERE h.lead_id = ev.lead_id AND h.direction = 'out' AND h.requisition_id IS NOT NULL AND (h.delivery_status IS NULL OR h.delivery_status <> 'failed') AND h.created_at <= ev.created_at ORDER BY h.created_at DESC, h.id DESC LIMIT 1) LEFT JOIN he_drive d ON d.id = x.drive_id LEFT JOIN he_match m ON m.lead_id = ev.lead_id AND m.requisition_id = x.requisition_id LEFT JOIN requisition_stream_match sm ON sm.match_id = m.id LEFT JOIN requisition_stream rs ON rs.id = sm.stream_id AND rs.requisition_id = x.requisition_id LEFT JOIN he_lead al ON al.id = ev.lead_id LEFT JOIN meta_lead_raw alf ON alf.id = al.meta_lead_id COLLATE utf8mb4_unicode_ci WHERE ev.event_type IN ('confirmed','call_confirmed') AND ev.created_at >= ? AND ev.created_at < ? AND x.requisition_id IN (?) UNION ALL SELECT (d.drive_date >= ?), al.mobile10 COLLATE utf8mb4_unicode_ci, d.requisition_id COLLATE utf8mb4_unicode_ci, NULL, ev.lead_id AS tl, (COALESCE(rs.source_type, 'he') <> 'he' OR (d.source_kind IN ('meta','campaign') OR (d.source_kind = 'batch' AND EXISTS (SELECT 1 FROM he_import_batch hib WHERE hib.source = 'meta' AND JSON_CONTAINS(d.source_ids, JSON_QUOTE(hib.id)))))) AS tm, (d.drive_date >= TIMESTAMP '2026-10-08 00:00:00') AS tr, alf.campaign_id COLLATE utf8mb4_unicode_ci, 1, 4, 0, 0, 0 FROM he_drive d JOIN he_lead_event ev ON ev.drive_id = d.id AND ev.event_type = 'arrived' LEFT JOIN he_match m ON m.lead_id = ev.lead_id AND m.requisition_id = d.requisition_id LEFT JOIN requisition_stream_match sm ON sm.match_id = m.id LEFT JOIN requisition_stream rs ON rs.id = sm.stream_id AND rs.requisition_id = d.requisition_id LEFT JOIN he_lead al ON al.id = ev.lead_id LEFT JOIN meta_lead_raw alf ON alf.id = al.meta_lead_id COLLATE utf8mb4_unicode_ci WHERE d.requisition_id IN (?) AND d.drive_date BETWEEN ? AND ? ) u WHERE u.person IS NOT NULL AND u.person <> '' GROUP BY u.cur, u.person, u.requisition_id ) p",
  "SELECT param_key FROM he_model_param WHERE param_key LIKE ? AND value = 1",
]
`;
