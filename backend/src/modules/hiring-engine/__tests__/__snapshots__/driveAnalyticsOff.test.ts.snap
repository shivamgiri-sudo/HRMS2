exports[`drive analytics with the plan 5 switches off > matches the recorded output and statement list > statements 1`] = `
[
  "SELECT STRAIGHT_JOIN COALESCE(rs.source_type, 'he') AS source_type, COUNT(DISTINCT CASE WHEN ((hl.status = 'joined' OR LOWER(ac.current_stage) IN ('joined','payroll_validated')) OR m.state = 'selected' OR LOWER(ac.current_stage) IN ('selected','offered','offer','offer_approved','onboarded','converted')) THEN m.id END) AS selected, COUNT(DISTINCT CASE WHEN (hl.status = 'joined' OR LOWER(ac.current_stage) IN ('joined','payroll_validated')) THEN m.id END) AS joined, COUNT(DISTINCT CASE WHEN m.state = 'slot_released' THEN m.id END) AS slot_released FROM he_drive d JOIN he_match m ON m.drive_id = d.id AND m.requisition_id = d.requisition_id LEFT JOIN requisition_stream_match sm ON sm.match_id = m.id LEFT JOIN requisition_stream rs ON rs.id = sm.stream_id AND rs.requisition_id = d.requisition_id LEFT JOIN he_lead hl ON hl.id = m.lead_id LEFT JOIN ats_candidate ac ON ac.id = hl.ats_candidate_id COLLATE utf8mb4_unicode_ci WHERE d.requisition_id IN (?) AND d.drive_date BETWEEN ? AND ? GROUP BY 1",
  "SELECT STRAIGHT_JOIN COALESCE(rs.source_type, 'he') AS source_type, COUNT(DISTINCT CASE WHEN ((hl.status = 'joined' OR LOWER(ac.current_stage) IN ('joined','payroll_validated')) OR m.state = 'selected' OR LOWER(ac.current_stage) IN ('selected','offered','offer','offer_approved','onboarded','converted')) THEN m.id END) AS selected, COUNT(DISTINCT CASE WHEN (hl.status = 'joined' OR LOWER(ac.current_stage) IN ('joined','payroll_validated')) THEN m.id END) AS joined, COUNT(DISTINCT CASE WHEN m.state = 'slot_released' THEN m.id END) AS slot_released FROM he_drive d JOIN he_match m ON m.drive_id = d.id AND m.requisition_id = d.requisition_id LEFT JOIN requisition_stream_match sm ON sm.match_id = m.id LEFT JOIN requisition_stream rs ON rs.id = sm.stream_id AND rs.requisition_id = d.requisition_id LEFT JOIN he_lead hl ON hl.id = m.lead_id LEFT JOIN ats_candidate ac ON ac.id = hl.ats_candidate_id COLLATE utf8mb4_unicode_ci WHERE d.requisition_id IN (?) AND d.drive_date BETWEEN ? AND ? GROUP BY 1",
  "SELECT STRAIGHT_JOIN COALESCE(rs.source_type, 'he') AS source_type, WEEKDAY(ev.created_at) AS wd, HOUR(ev.created_at) AS hr, COUNT(DISTINCT m.id) AS n FROM he_drive d JOIN he_match m ON m.drive_id = d.id AND m.requisition_id = d.requisition_id LEFT JOIN requisition_stream_match sm ON sm.match_id = m.id LEFT JOIN requisition_stream rs ON rs.id = sm.stream_id AND rs.requisition_id = d.requisition_id JOIN he_lead_event ev ON ev.drive_id = d.id AND ev.lead_id = m.lead_id AND ev.event_type = 'arrived' WHERE d.requisition_id IN (?) AND d.drive_date BETWEEN ? AND ? GROUP BY 1, 2, 3",
  "SELECT STRAIGHT_JOIN COALESCE(rs.source_type, 'he') AS source_type, WEEKDAY(hm.created_at) AS wd, HOUR(hm.created_at) AS hr, COUNT(DISTINCT hm.id) AS n FROM he_drive d JOIN he_match m ON m.drive_id = d.id AND m.requisition_id = d.requisition_id LEFT JOIN requisition_stream_match sm ON sm.match_id = m.id LEFT JOIN requisition_stream rs ON rs.id = sm.stream_id AND rs.requisition_id = d.requisition_id JOIN he_message hm ON hm.lead_id = m.lead_id AND hm.direction = 'in' AND hm.created_at >= ? AND hm.created_at < ? WHERE d.requisition_id IN (?) AND d.drive_date BETWEEN ? AND ? GROUP BY 1, 2, 3",
  "SELECT jr.id AS requisition_id, jr.requisition_code, jr.designation_name, d.branch_name, d.id, d.drive_date, d.status, d.target_shows, s.id AS stream_id, s.source_type, COUNT(m.id) AS lined, SUM(m.state IN ('invited','confirmed','slot_released','arrived','no_show','selected')) AS invited, SUM(m.state IN ('confirmed','arrived','selected')) AS confirmed, SUM(m.state IN ('arrived','selected')) AS arrived, SUM(m.state = 'no_show') AS no_show, SUM(m.state = 'declined') AS declined FROM job_requisition jr LEFT JOIN he_drive d ON d.requisition_id = jr.id COLLATE utf8mb4_unicode_ci AND d.drive_date BETWEEN ? AND ? LEFT JOIN he_match m ON m.drive_id = d.id AND m.requisition_id = d.requisition_id LEFT JOIN requisition_stream_match sm ON sm.match_id = m.id LEFT JOIN requisition_stream s ON s.id = sm.stream_id AND s.requisition_id = d.requisition_id WHERE jr.id IN (?) GROUP BY jr.id, d.id, s.id",
  "SELECT jr.id AS requisition_id, jr.requisition_code, jr.designation_name, d.branch_name, d.id, d.drive_date, d.status, d.target_shows, s.id AS stream_id, s.source_type, COUNT(m.id) AS lined, SUM(m.state IN ('invited','confirmed','slot_released','arrived','no_show','selected')) AS invited, SUM(m.state IN ('confirmed','arrived','selected')) AS confirmed, SUM(m.state IN ('arrived','selected')) AS arrived, SUM(m.state = 'no_show') AS no_show, SUM(m.state = 'declined') AS declined FROM job_requisition jr LEFT JOIN he_drive d ON d.requisition_id = jr.id COLLATE utf8mb4_unicode_ci AND d.drive_date BETWEEN ? AND ? LEFT JOIN he_match m ON m.drive_id = d.id AND m.requisition_id = d.requisition_id LEFT JOIN requisition_stream_match sm ON sm.match_id = m.id LEFT JOIN requisition_stream s ON s.id = sm.stream_id AND s.requisition_id = d.requisition_id WHERE jr.id IN (?) GROUP BY jr.id, d.id, s.id",
  "SELECT jr.id, jr.requisition_code, jr.designation_name, jr.branch_name, MAX(x.last_drive) AS last_drive FROM ( SELECT d.requisition_id COLLATE utf8mb4_unicode_ci AS rid, MAX(d.drive_date) AS last_drive FROM he_drive d WHERE d.drive_date BETWEEN ? AND ? GROUP BY d.requisition_id UNION ALL SELECT mc.requisition_id COLLATE utf8mb4_unicode_ci, NULL FROM meta_campaign mc WHERE mc.campaign_status = 'active' AND mc.requisition_id IS NOT NULL ) x JOIN job_requisition jr ON jr.id = x.rid COLLATE utf8mb4_unicode_ci WHERE 1 = 1 GROUP BY jr.id, jr.requisition_code, jr.designation_name, jr.branch_name ORDER BY MAX(x.last_drive) IS NULL, MAX(x.last_drive) DESC, jr.id LIMIT 201",
  "SELECT qf.source_type, qf.stopped_reason, COUNT(*) AS n FROM qualified_followup qf WHERE qf.requisition_id IN (?) AND qf.qualified_at >= ? AND qf.qualified_at < ? AND qf.stopped_reason IN ('opted_out','requisition_closed','no_contact_details') GROUP BY qf.source_type, qf.stopped_reason",
]
`;
