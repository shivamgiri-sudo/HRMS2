  },
  {
    "params": [
      "2026-07-01",
      "2026-07-31",
      "b1",
    ],
    "sql": "SELECT COUNT(*) AS total, COALESCE(SUM(rda.override_by IS NOT NULL), 0) AS overrides FROM roster_decision_audit rda LEFT JOIN employees e ON rda.employee_id = e.id WHERE rda.roster_date BETWEEN ? AND ? AND (rda.rule_applied IS NULL OR rda.rule_applied NOT LIKE 'error:%') AND COALESCE(rda.branch_id, e.branch_id) = ?",
  },
  {
    "params": [
      "2026-08-01",
      "2026-08-31",
      "b1",
    ],
    "sql": "SELECT rgr.run_type, rgr.status, COUNT(*) AS count, SUM(rgr.assignments_created) AS assignments, SUM(rgr.conflicts_found) AS conflicts FROM roster_generation_run rgr WHERE rgr.started_at >= ? AND rgr.started_at < DATE_ADD(?, INTERVAL 1 DAY) AND rgr.branch_id = ? GROUP BY rgr.run_type, rgr.status",
