    "sql": "SELECT COUNT(*) AS count FROM ( SELECT e.id, COUNT(*) AS weekoffs FROM wfm_roster_assignment ra JOIN employees e ON ra.employee_id = e.id WHERE ra.roster_date BETWEEN ? AND ? AND NOT (ra.import_batch_id IS NULL AND ra.cycle_id IS NULL AND ra.assignment_type IS NULL AND ra.shift_template_id IS NULL) AND ra.is_week_off = 1 AND e.branch_id = ? AND e.process_id = ? GROUP BY e.id HAVING weekoffs < 4 ) AS weekoff_violations",
