// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`legacy Meta outreach pin (switches off) > notifyNewQualifiedLeads SQL 1`] = `
[
  {
    "p": [
      "<backfill cutoff (UTC)>",
      "<window start>",
    ],
    "sql": "SELECT id, (SELECT JSON_EXTRACT(jr.meta_screening_config, '$.auto_notify') = CAST('false' AS JSON) FROM job_requisition jr WHERE jr.id = meta_lead_raw.requisition_id) AS auto_notify_off, CONVERT_TZ(STR_TO_DATE(LEFT(JSON_UNQUOTE(JSON_EXTRACT(meta_lead_raw.raw_payload, '$.created_time')), 19), '%Y-%m-%dT%H:%i:%s'), IF(JSON_UNQUOTE(JSON_EXTRACT(meta_lead_raw.raw_payload, '$.created_time')) REGEXP '[+-][0-9]{4}$', CONCAT(SUBSTRING(JSON_UNQUOTE(JSON_EXTRACT(meta_lead_raw.raw_payload, '$.created_time')), -5, 3), ':', RIGHT(JSON_UNQUOTE(JSON_EXTRACT(meta_lead_raw.raw_payload, '$.created_time')), 2)), '+00:00'), '+00:00') < ? AS is_backfill FROM meta_lead_raw WHERE screening_result = 'qualified' AND notification_sent_at IS NULL AND created_at >= ? AND NOT EXISTS (SELECT 1 FROM qualified_followup qf WHERE qf.mode_at_enqueue IN ('live','canary') AND (qf.meta_lead_id = meta_lead_raw.id COLLATE utf8mb4_unicode_ci OR (qf.mobile10 = RIGHT(REGEXP_REPLACE(meta_lead_raw.parsed_phone, '[^0-9]', ''), 10) COLLATE utf8mb4_unicode_ci AND qf.requisition_id = meta_lead_raw.requisition_id COLLATE utf8mb4_unicode_ci))) AND NOT EXISTS (SELECT 1 FROM qualified_followup q2 WHERE q2.meta_lead_id = meta_lead_raw.id COLLATE utf8mb4_unicode_ci) HAVING (auto_notify_off = 1 OR is_backfill = 1) ORDER BY created_at ASC LIMIT 100",
  },
  {
    "p": [
      "<backfill cutoff (UTC)>",
      "<window start>",
    ],
    "sql": "SELECT id, (SELECT JSON_EXTRACT(jr.meta_screening_config, '$.auto_notify') = CAST('false' AS JSON) FROM job_requisition jr WHERE jr.id = meta_lead_raw.requisition_id) AS auto_notify_off, CONVERT_TZ(STR_TO_DATE(LEFT(JSON_UNQUOTE(JSON_EXTRACT(meta_lead_raw.raw_payload, '$.created_time')), 19), '%Y-%m-%dT%H:%i:%s'), IF(JSON_UNQUOTE(JSON_EXTRACT(meta_lead_raw.raw_payload, '$.created_time')) REGEXP '[+-][0-9]{4}$', CONCAT(SUBSTRING(JSON_UNQUOTE(JSON_EXTRACT(meta_lead_raw.raw_payload, '$.created_time')), -5, 3), ':', RIGHT(JSON_UNQUOTE(JSON_EXTRACT(meta_lead_raw.raw_payload, '$.created_time')), 2)), '+00:00'), '+00:00') < ? AS is_backfill FROM meta_lead_raw WHERE screening_result = 'qualified' AND notification_sent_at IS NULL AND created_at >= ? AND NOT EXISTS (SELECT 1 FROM qualified_followup qf WHERE qf.mode_at_enqueue IN ('live','canary') AND (qf.meta_lead_id = meta_lead_raw.id COLLATE utf8mb4_unicode_ci OR (qf.mobile10 = RIGHT(REGEXP_REPLACE(meta_lead_raw.parsed_phone, '[^0-9]', ''), 10) COLLATE utf8mb4_unicode_ci AND qf.requisition_id = meta_lead_raw.requisition_id COLLATE utf8mb4_unicode_ci))) HAVING COALESCE(auto_notify_off, 0) = 0 AND COALESCE(is_backfill, 0) = 0 ORDER BY created_at ASC LIMIT 100",
  },
]
`;

