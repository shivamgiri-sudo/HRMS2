{
  // Typecheck for the COSEC monitoring role-split + billing-config role alignment
  // (attendance-console merge, Task 2).
  //
  // Deliberately NOT the repo-wide `tsc -p tsconfig.json` — see global-constraints.md #9 and
  // tsconfig.attendance-check.json for why. Scope to the touched files instead:
  //
  //     npx tsc -p tsconfig.cosecroles-check.json
  //
  // Transitively pulled-in modules are still checked, so pre-existing errors from other
  // people's files may appear; these three files are expected to stay clean.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "src/modules/peopleos/peopleos.routes.ts",
    "src/modules/peopleos/peopleos.service.ts",
    "src/modules/attendance/billing-config.routes.ts"
  ]
}
