# Copy to .env (install.sh does this) and keep it chmod 600. Never commit .env.

# Where the UIs listen. 127.0.0.1 = this machine only. On the server, use its LAN IP
# (e.g. 192.168.11.225) so the office network can open them. Never 0.0.0.0 on a public host.
BIND_IP=127.0.0.1
GT_PORT=8710
KUMA_PORT=3001

# The URL people (and HRMS's browsers) use to reach GlitchTip. Browsers send errors here, so it
# must be reachable from employees' browsers if frontend error reporting is turned on.
GT_PUBLIC_URL=http://127.0.0.1:8710

# Filled automatically by install.sh on first run.
GT_SECRET_KEY=
GT_DB_PASSWORD=

# GlitchTip admin, created by install.sh. Password is generated if left empty.
GT_ADMIN_EMAIL=it-admin@teammas.in
GT_ADMIN_PASSWORD=

# Outgoing mail for GlitchTip alerts, e.g. smtp://user:pass@smtp.office365.com:587/?tls=True
GT_EMAIL_URL=consolemail://
GT_FROM_EMAIL=glitchtip@teammas.in
GT_EVENT_RETENTION_DAYS=30

# Pinned versions.
GT_VERSION=6.2.6
KUMA_VERSION=2.5.6
