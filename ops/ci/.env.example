# ops/ci — copy to .env. Never commit .env.
# Local test: BIND_IP=127.0.0.1   Production: BIND_IP=192.168.11.225

BIND_IP=127.0.0.1

# GitHub OAuth App — create at:
#   https://github.com/settings/applications/new
#   Application name:  HRMS Woodpecker CI
#   Homepage URL:      http://192.168.11.225:3333
#   Callback URL:      http://192.168.11.225:3333/authorize
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Your GitHub username — gets Woodpecker admin access
GITHUB_ADMIN_USER=your-github-username
GITHUB_REPO_OWNER=your-github-username

# Generated by install.sh — leave blank
AGENT_SECRET=
