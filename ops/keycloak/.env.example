# ops/keycloak — copy to .env. Never commit .env.

# Public HTTPS URL where Keycloak is reachable (nginx terminates TLS on this URL)
# nginx-keycloak.conf proxies this to http://127.0.0.1:8180 internally
KC_HOSTNAME=https://192.168.11.225:8443

# MySQL — dedicated keycloak database on existing HRMS MySQL server
KC_DB_HOST=192.168.10.6
KC_DB_PORT=3306
KC_DB_NAME=mas_keycloak
KC_DB_USER=kc_user
KC_DB_PASSWORD=

# Keycloak admin credentials — password generated by install.sh if blank
KC_ADMIN_USER=kc-admin
KC_ADMIN_PASSWORD=
