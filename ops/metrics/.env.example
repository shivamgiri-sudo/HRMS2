# ops/metrics — copy to .env. Never commit .env.
# Local test: BIND_IP=127.0.0.1   Production: BIND_IP=192.168.11.225

BIND_IP=127.0.0.1

# Grafana admin password — generated by install.sh if left blank
GRAFANA_ADMIN_PASSWORD=

# MySQL read-only metrics user (install.sh creates mysql-exporter.cnf from these)
# Create the user first: GRANT SELECT, PROCESS, REPLICATION CLIENT ON *.* TO 'metrics_reader'@'%' IDENTIFIED BY '...';
METRICS_DB_HOST=192.168.10.6
METRICS_DB_USER=metrics_reader
METRICS_DB_PASSWORD=
