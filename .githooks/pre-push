#!/bin/sh
#
# Refuse a push that breaks one of the three cheap structural guards.
#
# WHY THIS EXISTS
#   On 2026-08-17 six defects reached main in one day: three migrations registered in neither
#   MIGRATION_MANIFEST nor knownUnlisted (1226, 1229, 530), a query selecting three columns that
#   do not exist (COSEC registration, which therefore failed for every new hire), and a frontend
#   call to a route deleted the same morning (the profile Leave History tab, answered 401).
#
#   Every one of them was caught instantly, by name, by a test already in this repository. Nobody
#   saw any of it, because GitHub Actions could not start a single job that day — so every commit
#   showed the same red and red stopped carrying information. The defects were found hours later,
#   in a batch, by a 35-minute local suite.
#
#   The full suite is too slow to run before every push, and a guard nobody runs is not a guard.
#   These three take ~30 seconds together and cover exactly the class that got through.
#
# WHAT IT DOES NOT DO
#   This is not the test suite and does not replace it. It proves three specific things:
#   every migration file is scheduled, every SQL identifier exists in the schema snapshot, and
#   every frontend API call resolves to a registered route. A push that clears this hook can
#   still break behaviour — run the full suite before anything that matters.
#
# BYPASS
#   git push --no-verify
#   Legitimate when the machine cannot run tests (this repo has hit a filter-driver fault that
#   makes vitest hang), or when pushing a branch you know is mid-work. Not legitimate as a habit:
#   the whole cost of these six defects was that nothing was checking.

set -u

# Nothing to check on a delete-only push.
if [ -t 0 ]; then : ; else
  saw_ref=0
  while read -r _local_ref local_sha _remote_ref _remote_sha; do
    saw_ref=1
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] || has_commits=1
  done
  if [ "$saw_ref" = "1" ] && [ "${has_commits:-0}" != "1" ]; then
    exit 0
  fi
fi

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$repo_root/backend" 2>/dev/null || {
  echo "pre-push: backend/ not found, skipping structural guards" >&2
  exit 0
}

# Skip rather than fail when dependencies are not installed — a fresh clone that has not run
# npm install yet should not be unable to push.
[ -d node_modules/vitest ] || {
  echo "pre-push: backend/node_modules/vitest missing, skipping structural guards" >&2
  exit 0
}

echo "pre-push: structural guards (migrations, schema refs, route contract) — about 30s..."

GUARDS="src/db/__tests__/migration-manifest-guard.test.ts
src/db/__tests__/schema-column-refs.test.ts
src/platform/__tests__/route-contract.test.ts"

# Output goes to a file rather than through a pipe on purpose. `cmd | tail` reports tail's exit
# status, not cmd's — tail always succeeds, so the piped form made this hook pass while the guard
# underneath it was failing. Verified by planting an unregistered migration: the guard flagged it
# and the hook still exited 0.
out=$(mktemp 2>/dev/null || echo "${TMPDIR:-/tmp}/prepush.$$")
# shellcheck disable=SC2086
npx vitest run $(echo $GUARDS) --silent >"$out" 2>&1
status=$?

if [ "$status" -eq 0 ]; then
  rm -f "$out"
  echo "pre-push: guards passed"
  exit 0
fi

tail -30 "$out" >&2
rm -f "$out"

cat >&2 <<'MSG'

pre-push: BLOCKED — a structural guard failed.

  These three catch the defects that reached main unseen while CI was down:
    migration-manifest-guard  a migration file scheduled nowhere never runs
    schema-column-refs        a column or table that does not exist throws at runtime
    route-contract            a frontend call with no backend route (answered 401 here, not 404)

  Read the failure above: each names the exact file, migration or column.
  Fix it, or if you are certain this is not your change, say so in the commit message.

  To push anyway (machine cannot run tests, or branch is mid-work):
    git push --no-verify

MSG
exit 1
