+                    UNION SELECT 5 UNION SELECT 6 UNION SELECT 7 UNION SELECT 8 UNION SELECT 9
+                    UNION SELECT 10 UNION SELECT 11) months
+             WHERE DATE_ADD(DATE(?), INTERVAL n MONTH) <= DATE(?)
+          ) ms
+         WHERE ${scopeSql}
+         GROUP BY ms.month_start
+      ) m
+     ORDER BY month`;
