+
+function NameStatusChip({ status }: { status?: string | null }) {
+  if (!status || status === "not_checked" || status === "pending") return (
+    <span className="text-[11px] text-slate-400 bg-slate-100 px-2 py-0.5 rounded-full">Not checked</span>
