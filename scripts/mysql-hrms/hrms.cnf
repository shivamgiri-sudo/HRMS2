# Dedicated MySQL instance for HRMS (mas_hrms + db_masmis, plus replicas of the read-only feed schemas).
# Installed to /etc/mysql-hrms/hrms.cnf by 01-create-instance.sh.
#
# Sized for the app server: 10 cores, 14 GB RAM shared with the Node apps and the LMS MySQL.
# Raise innodb_buffer_pool_size to 8G once the VM has >= 24 GB RAM.
# Behavioural settings (sql_mode, collation, lock timeouts, time zone) deliberately match the
# current source server (dialer-report-server, MySQL 8.0.42), measured 2026-09-30.

[mysqld]
user                            = mysql
port                            = 3307
bind-address                    = 127.0.0.1
mysqlx                          = OFF
skip-name-resolve
socket                          = /run/mysqld-hrms/mysqld.sock
pid-file                        = /run/mysqld-hrms/mysqld.pid
datadir                         = /var/mysql-hrms/data
tmpdir                          = /var/mysql-hrms/tmp
log-error                       = /var/mysql-hrms/mysqld-error.log

# ---- parity with the source server -----------------------------------------------------------
character-set-server            = utf8mb4
collation-server                = utf8mb4_0900_ai_ci
lower_case_table_names          = 0
default-time-zone               = '+05:30'
sql_mode                        = ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION
transaction_isolation           = REPEATABLE-READ
explicit_defaults_for_timestamp = ON
max_allowed_packet              = 64M
innodb_lock_wait_timeout        = 60
lock_wait_timeout               = 120
local_infile                    = OFF

# The source runs an event (ev_refresh_master_employee). Keep the scheduler OFF until cutover,
# otherwise the event would run on both servers. Phase 5 switches it on.
event_scheduler                 = OFF

# ---- InnoDB ------------------------------------------------------------------------------------
innodb_buffer_pool_size         = 6G
innodb_redo_log_capacity        = 2G
innodb_log_buffer_size          = 64M
innodb_flush_log_at_trx_commit  = 1
innodb_flush_method             = O_DIRECT
# The OS reports the disk as rotational although a raw write test was fast. Stay conservative and
# raise after a real fio benchmark.
innodb_io_capacity              = 1000
innodb_io_capacity_max          = 2000
innodb_read_io_threads          = 8
innodb_write_io_threads         = 8
innodb_file_per_table           = 1

# ---- connections and memory --------------------------------------------------------------------
# Backend pool (DB_POOL_MAX=50) + workers pool (50) + side pools + admin.
max_connections                 = 300
thread_cache_size               = 64
table_open_cache                = 6000
table_definition_cache          = 3000
open_files_limit                = 65535
# The source uses the 16 MB defaults, which spill dashboard GROUP BYs to disk.
tmp_table_size                  = 128M
max_heap_table_size             = 128M
join_buffer_size                = 1M

# ---- binary log: point-in-time recovery and (Phase 6) reverse replication for rollback ---------
server-id                       = 2
log_bin                         = /var/mysql-hrms/binlog/binlog
binlog_format                   = ROW
binlog_expire_logs_seconds      = 604800
max_binlog_size                 = 512M
sync_binlog                     = 1
# The source has GTID off; replication from it is position based.
gtid_mode                       = OFF
enforce_gtid_consistency        = OFF
log_replica_updates             = ON

# ---- diagnostics (the source login could not see these; this instance can) ---------------------
performance_schema              = ON
slow_query_log                  = ON
slow_query_log_file             = /var/mysql-hrms/slow.log
long_query_time                 = 2
log_slow_extra                  = ON
log_slow_admin_statements       = ON

# ---- Phase 3 (replication from the source), enabled by 04-replication.sh, NOT now --------------
# replicate-wild-do-table = mas_hrms.%
# replicate-wild-do-table = db_masmis.%
# replicate-wild-do-table = db_audit.%
# replicate-wild-do-table = db_external.%
# replicate-wild-do-table = Shivamgiri.%
