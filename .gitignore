.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.env
.vercel

# Local dev tools with credentials — never commit
backend/mysql-tunnel.cjs
backend/*.tunnel.cjs

# Local disk uploads — never commit uploaded files
backend/uploads/
backend/private-storage/

# Backend env files with credentials — never commit
backend/.env
backend/.env.production
backend/.env.test
backend/.env.backup
backups/
.env
.claude/settings.json

# Playwright test output — never commit
playwright-report/
playwright-results.json
test-results/
.tmp-backend.err
tools/schema-auditor/dist/
tools/schema-auditor/logs/
tools/schema-auditor/reports/*
!tools/schema-auditor/reports/.gitkeep
tools/schema-auditor/snapshots/*
!tools/schema-auditor/snapshots/.gitkeep
tools/schema-auditor/.env.schema-auditor
tools/schema-auditor/.env.schema-auditor.local

# Stray Windows artifacts — `cmd ... 2>nul` in a POSIX shell creates a literal
# file called "nul" instead of discarding output.
nul
**/nul

# Runtime upload storage — user-generated files, never source
uploads/

# Local dev logs (narrow: backend/backend.err and .codex-tmp assets are tracked,
# so do NOT use a blanket *.err or .codex-tmp/ rule — it would shadow them)
backend/backend-dev-restart.err

# Agent/tool scratch worktrees
.claude/worktrees/
.codex-tmp/finance-pr58-worktree/

# Privacy scan output — a map of every PII column in the database.
#
# backend/src/scripts/privacy-inventory-scan.ts defaults to writing
# privacy-inventory-findings.json into whatever directory it is run from, and that file
# enumerates 505 candidate PII columns across 173 tables. This repository is public, so one
# `git add -A` (which the concurrent-agent rules forbid and agents keep doing anyway) would
# publish an index of exactly where the sensitive data lives. Ignored by name and by pattern
# so it cannot land wherever the script happens to be run.
privacy-inventory-findings.json
**/privacy-inventory-findings.json
*privacy-findings*.json

# Standalone Google Apps Script reference files (not part of this app's
# build) -- consolidated-dashboard-email-report.gs has a hardcoded root
# MySQL password (dialer_db on 122.184.128.90) in its CONFIG block. Kept
# on disk for reference only; excluded by directory so it can never enter
# this public repo's history via a broad `git add`.
/scripts/apps-script/
