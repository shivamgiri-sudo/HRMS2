# Backup files
*.bak

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr

# Zipped/tarred dist build output left at repo root from a manual deploy --
# same category as dist/ above, just packaged; not source.
/dist-*.zip
/dist-*.tar.gz

# --- Initial public push (2026-09-15): operational docs/scripts, not source ---
# This directory accumulated months of session-report/audit/deploy markdown at
# the repo root, several containing real plaintext credentials (test-account
# passwords, internal server IPs, DB usernames) never meant for a public repo.
# Excluding by structure rather than hand-vetting hundreds of files: every
# loose root-level *.md/*.txt/*.sh/*.py/*.ps1/*.bat is a report or ops script,
# not application source, EXCEPT the standard project docs explicitly kept
# below. Nested docs (ceo-mcp-package/README.md, mcp-server/README.md, etc.)
# are unaffected -- these patterns are root-anchored.
/*.md
!/README.md
!/CONTRIBUTING.md
!/SECURITY.md
!/RELEASE.md
/*.txt
/*.sh
/*.py
/*.ps1
/*.bat

# Session-report/audit/plan directories -- not application source.
/docs/
/.superpowers/
/backend/docs/
/audit_reports/
/uat/
/scripts-uat/
/tasks/
/pictures/
/demo/
/graphify-out/
/e2e-test-results/

# AI-tool scratch workspace (PDF-fill experiments for contract/EPF forms) --
# not application source, and its "filled" previews haven't been vetted for
# whether they carry real vs. sample employee data. Only one narrow subpath
# was previously ignored (finance-pr58-worktree); excluding the whole tree.
/.codex-tmp/

# Loose dev-generated appointment-letter preview PDFs at backend/ root --
# generated output from testing the feature (one checked: clearly fake/test
# data, "SHIVAM TEST", letter ID ".../PREVIEW"), not source either way.
/backend/appt_preview*.pdf
/backend/UsersADMINDesktopappointment_letter_PREVIEW.pdf

# Loose root-level dashboard screenshots from dev/testing sessions -- same
# reasoning as /pictures/ above.
/ceo-dashboard-full.png
/employee-dashboard-full.png
/employee-dashboard-test.png
*.local

