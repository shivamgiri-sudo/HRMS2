# ──────────────────────────────────────────────────────────────────
# MAS Callnet HRMS MCP Server — Environment Config
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────────

# Database connection (get these from your DB admin)
DB_HOST=192.168.10.6
DB_PORT=3306
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=mas_hrms

# Your access role — controls which tables you can query.
# Ask your admin which role to use.
#
#   viewer      → Org structure + headcount only
#   hr          → viewer + attendance, leave, leave balances
#   recruitment → hr + full ATS candidate pipeline
#   management  → recruitment + KPI + process performance + WFM roster
#   finance     → management + P&L cost/revenue components
#   full        → all of the above (no payroll/statutory ever)
#
HRMS_ROLE=viewer

# ── HTTP mode (for hosting on a server so others connect via URL) ──
HTTP_PORT=3099
# Generate a strong random token and share it with users
MCP_TOKEN=change-this-to-a-secret-token
