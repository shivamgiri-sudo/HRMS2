        "backend/src/modules/reporting/**",
        "backend/src/modules/analytics/**",
        "backend/src/modules/business-intelligence/**",
        "backend/src/modules/dashboards/**"
      ],
      "tables": ["report_*", "dashboard_*"],
      "keywords": ["report", "dashboard", "export", "\\btotal\\b", "count is wrong", "figure", "mismatch", "does not tally"],
