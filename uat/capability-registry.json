{
  "$comment": "Business-capability risk classification for the UAT pipeline. Dimension two of two; see uat/protected-paths.json for the path floor. effective_risk = max(path_tier, capability_class). This exists because a path-only model misses the most common real failure: an apparently harmless file edit that nevertheless changes an HR policy outcome. Detection is the UNION of three signals (path glob, table/column name, keyword), so a capability fires even when no protected file matches. Deliberately over-broad; a false positive costs one human review. This file is HRMS policy configuration, not code: deny-tier, CODEOWNERS-governed, and never editable by the pipeline.",
  "version": 1,
  "classes": {
    "DENY": "Human engineering only. The pipeline halts before any LLM call.",
    "HIGH_REVIEW": "Requires a domain owner AND a technical reviewer before dispatch.",
    "REVIEW": "Requires the named domain owner before dispatch.",
    "STANDARD": "Eligible for the automated path.",
    "TRIVIAL": "Eligible for the automated path; lowest scrutiny."
  },
  "capabilities": [
    {
      "key": "payroll_calculation",
      "name": "Payroll calculation, F&F and statutory",
      "class": "DENY",
      "requiredApproverRoles": [],
      "mandatoryTests": [],
      "paths": [
        "backend/src/modules/payroll/**",
        "backend/src/modules/payroll-compliance/**",
        "backend/src/modules/payroll-masters/**",
        "backend/src/modules/salary-increment/**",
        "backend/src/modules/incentives/**",
        "backend/src/modules/benefits/**",
        "backend/src/modules/ats/salary.calculator.ts",
        "src/lib/payslipPdfGenerator.ts",
        "src/lib/masCallnetPayslipGenerator*.ts"
      ],
      "tables": [
        "payroll_*", "salary_*", "statutory_config", "pf_*", "esic_*", "tds_*",
        "gratuity_*", "payslip*", "deduction_*", "loan_*", "reimbursement_*", "ff_*"
      ],
      "keywords": [
        "payroll", "pay\\s?slip", "salary", "\\bCTC\\b", "\\bPF\\b", "\\bUAN\\b", "\\bESIC?\\b",
        "\\bTDS\\b", "gratuity", "F&F", "full and final", "arrear", "professional tax",
        "\\bPT slab\\b", "net pay", "gross pay", "payable days", "deduction", "increment",
        "incentive", "bonus"
      ],
      "reason": "Payroll arithmetic is read-only by standing project rule, and three rival engines mean a partial change is a silent divergence. Quantify and report; never correct."
    },
    {
      "key": "auth_rbac",
      "name": "Authentication, RBAC and session",
      "class": "DENY",
      "requiredApproverRoles": [],
      "mandatoryTests": [],
      "paths": [
        "backend/src/modules/auth/**",
        "backend/src/modules/access/**",
        "backend/src/modules/security/**",
        "backend/src/middleware/**",
        "backend/src/shared/rbacPageMatrix.ts",
        "backend/src/shared/accessGuard.ts",
        "backend/src/shared/scopeAccess.ts",
        "backend/src/shared/roleResolver.ts",
        "backend/src/shared/demoAuth.ts",
        "src/lib/rbacPageMatrix.ts",
        "src/lib/navigationAccess.ts",
        "src/contexts/AuthContext.tsx",
        "src/components/auth/**"
      ],
      "tables": ["users", "user_*", "role_*", "page_catalog", "user_page_access", "refresh_token*", "session*"],
      "keywords": [
        "login", "logout", "password", "\\bOTP\\b", "two.?factor", "\\b2FA\\b", "\\bJWT\\b",
        "token", "role", "permission", "access denied", "unauthori[sz]ed", "\\bRBAC\\b", "impersonat"
      ],
      "reason": "Dual-sided RBAC that can silently over-grant. A role check written as a union fails open."
    },
    {
      "key": "finance_payment",
      "name": "Finance, payment and disbursal",
      "class": "DENY",
      "requiredApproverRoles": [],
      "mandatoryTests": [],
      "paths": [
        "backend/src/modules/finance/**",
        "backend/src/modules/process-pnl/**",
        "backend/src/modules/integrations/luckpay/**",
        "backend/src/modules/payroll/disbursal.routes.ts",
        "backend/src/modules/erp/**",
        "backend/src/modules/revenue-risk/**"
      ],
      "tables": ["vendor_*", "grn_*", "budget_*", "pnl_*", "cost_centre*", "imprest_*", "payment_*", "invoice*"],
      "keywords": [
        "disburs", "payment", "penny.?drop", "bank transfer", "\\bNEFT\\b", "\\bIMPS\\b", "\\bRTGS\\b",
        "vendor payment", "\\bGRN\\b", "invoice", "budget", "\\bP&L\\b", "cost cent", "imprest"
      ],
      "reason": "Real money leaves the building through this code."
    },
    {
      "key": "attendance_classification",
      "name": "Attendance classification and punch interpretation",
      "class": "DENY",
      "requiredApproverRoles": ["UAT_DOMAIN_OWNER_HR", "UAT_DOMAIN_OWNER_OPS"],
      "mandatoryTests": [
        "backend/src/modules/dashboards/__tests__/attendance-canon.contract.test.ts"
      ],
      "paths": [
        "backend/src/modules/wfm/attendance-engine.service.ts",
        "backend/src/modules/wfm/attendance-reconciliation*.ts",
        "backend/src/modules/wfm/cosec-*.ts",
