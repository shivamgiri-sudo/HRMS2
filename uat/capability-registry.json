        "backend/src/shared/attendanceRestore.ts"
      ],
      "tables": ["attendance_*", "biometric_*", "punch_*", "cosec_*"],
      "keywords": [
        "punch", "biometric", "cosec", "attendance", "\\blate\\b", "half.?day", "absent",
        "present", "missing punch", "in.?time", "out.?time", "shift timing", "\\bLWP\\b"
      ],
      "reason": "Attendance feeds payable days. A misclassification here becomes a wrong salary without ever touching payroll code."
    },
    {
      "key": "leave_entitlement",
      "name": "Leave entitlement and accrual",
      "class": "HIGH_REVIEW",
      "requiredApproverRoles": ["UAT_DOMAIN_OWNER_HR", "UAT_TECH_REVIEWER"],
      "mandatoryTests": [],
      "paths": ["backend/src/modules/leave/**"],
      "tables": ["leave_*", "holiday_*", "comp_off*"],
      "keywords": [
        "leave", "accrual", "entitlement", "carry.?forward", "comp.?off", "\\bCL\\b", "\\bSL\\b",
        "\\bEL\\b", "\\bPL\\b", "encash", "leave balance", "holiday", "week.?off"
      ],
      "reason": "Leave balances are a monetary entitlement and feed encashment and F&F."
    },
    {
      "key": "roster_shift",
      "name": "Roster, shift, week-off and OT",
      "class": "HIGH_REVIEW",
      "requiredApproverRoles": ["UAT_DOMAIN_OWNER_WFM", "UAT_TECH_REVIEWER"],
      "mandatoryTests": [],
      "paths": [
        "backend/src/modules/roster/**",
        "backend/src/modules/wfm/auto-roster-*.ts",
        "backend/src/modules/wfm/wfm.regularization.secure.routes.ts",
        "backend/src/modules/wfm-extensions/**"
      ],
      "tables": ["roster_*", "shift_*", "week_off*", "overtime_*", "shrinkage_*"],
      "keywords": [
        "roster", "shift", "week.?off", "\\bOT\\b", "overtime", "regulari[sz]ation",
        "shrinkage", "schedule", "duty"
      ],
      "reason": "Roster is payroll input. A worked Sunday is paid and still counts toward the month's week-off entitlement — subtle rules that a naive edit breaks."
    },
    {
      "key": "employee_master",
      "name": "Employee master data",
      "class": "HIGH_REVIEW",
      "requiredApproverRoles": ["UAT_DOMAIN_OWNER_HR", "UAT_TECH_REVIEWER"],
      "mandatoryTests": [],
      "paths": [
        "backend/src/modules/employees/**",
        "backend/src/modules/lifecycle/**",
        "backend/src/modules/onboarding/**",
        "backend/src/modules/org/**",
        "backend/src/modules/org-chart/**"
      ],
      "tables": ["employees", "employee_*", "branch_master", "department_*", "designation_*"],
      "keywords": [
        "employee master", "employee code", "date of joining", "\\bDOJ\\b", "confirmation",
        "probation", "reporting manager", "branch transfer", "designation master",
        "department master", "employee record"
      ],
      "reason": "Employee master rows key payroll, attendance, access and statutory reporting. A bad write propagates everywhere."
