      "keywords": ["\\bKPI\\b", "\\bAPR\\b", "appraisal", "performance score", "rating", "quality score", "audit score"],
      "reason": "Performance scores drive increments and exits. One active config row silently disabled APR eligibility for an entire grade once already."
    },
    {
      "key": "reporting_calculations",
      "name": "Reports and dashboard calculations",
      "class": "REVIEW",
      "requiredApproverRoles": ["UAT_DOMAIN_OWNER_METRICS"],
      "mandatoryTests": [],
