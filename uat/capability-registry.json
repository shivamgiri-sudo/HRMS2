    {
      "key": "exit_ff_inputs",
      "name": "Exit, clearance and F&F inputs",
      "class": "HIGH_REVIEW",
      "requiredApproverRoles": ["UAT_DOMAIN_OWNER_HR", "UAT_DOMAIN_OWNER_FINANCE"],
      "mandatoryTests": [],
      "paths": ["backend/src/modules/exit/**"],
      "tables": ["exit_*", "clearance_*", "resignation_*", "ff_*", "noc_*"],
      "keywords": [
        "resignation", "exit", "clearance", "last working day", "\\bLWD\\b", "notice period",
        "relieving", "\\bNOC\\b", "settlement", "full and final"
