    },
    {
      "key": "ats_stage_logic",
      "name": "ATS selection and stage logic",
      "class": "REVIEW",
      "requiredApproverRoles": ["UAT_DOMAIN_OWNER_RECRUITMENT"],
      "mandatoryTests": [],
      "paths": [
        "backend/src/modules/ats/**",
        "backend/src/modules/ats-extensions/**",
        "backend/src/modules/ats-full-parity/**",
        "backend/src/modules/ats-assessment/**",
        "backend/src/modules/candidate-onboarding/**",
        "backend/src/modules/job-requisition/**",
        "backend/src/modules/ijp/**"
      ],
      "tables": ["candidate_*", "ats_*", "interview_*", "offer_*", "requisition_*"],
