    {
      "key": "performance_kpi",
      "name": "Performance and KPI calculation",
      "class": "REVIEW",
      "requiredApproverRoles": ["UAT_DOMAIN_OWNER_METRICS"],
      "mandatoryTests": [],
      "paths": [
        "backend/src/modules/kpi/**",
